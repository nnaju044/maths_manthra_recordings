<div class="container py-4">
  <!-- Student Profile Bar -->
  <div class="card border-0 shadow-sm rounded-4 mb-4 bg-primary text-white">
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex align-items-center gap-3">
          <div class="rounded-circle bg-white text-primary p-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 56px; height: 56px;">
            <i class="bi bi-person-fill fs-3"></i>
          </div>
          <div>
            <h4 class="fw-bold mb-1"><%= student.fullName || student.name %></h4>
            <div class="text-white-50 small">
              <span class="me-3"><i class="bi bi-envelope me-1"></i> <%= student.email %></span>
              <span class="me-3"><i class="bi bi-card-text me-1"></i> Student ID: <%= student.studentId || student.certificateNumber || 'N/A' %></span>
              <% if (student.courseId) { %>
                <span><i class="bi bi-book me-1"></i> Course: <%= student.courseId.title %></span>
              <% } %>
            </div>
          </div>
        </div>

        <form action="/exams/logout" method="POST" class="m-0">
          <button type="submit" class="btn btn-outline-light btn-sm px-3 rounded-pill">
            <i class="bi bi-box-arrow-right me-1"></i> Sign Out
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Section 1: Available Examinations -->
  <div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
      <div>
        <h4 class="fw-bold mb-1 text-dark">Available Examinations</h4>
        <p class="text-muted small mb-0">Browse and participate in active assessments and certifications.</p>
      </div>
    </div>

    <% if (!examCards || examCards.length === 0) { %>
      <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-light">
        <div class="mb-3 text-muted">
          <i class="bi bi-journal-x display-4"></i>
        </div>
        <h5 class="fw-bold text-secondary">No Examinations Available</h5>
        <p class="text-muted small mb-0">There are currently no active examinations scheduled for your account.</p>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% examCards.forEach(function(item) { %>
          <% const exam = item.exam; const el = item.eligibility; %>
          <div class="col-md-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
              <!-- Top Badge -->
              <div class="position-absolute top-0 end-0 p-3">
                <% if (el.statusTag === 'in_progress') { %>
                  <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill shadow-sm">
                    <i class="bi bi-clock-history me-1"></i> In Progress
                  </span>
                <% } else if (el.statusTag === 'available') { %>
                  <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill border border-success-subtle">
                    <i class="bi bi-check-circle me-1"></i> Available
                  </span>
                <% } else if (el.statusTag === 'upcoming') { %>
                  <span class="badge bg-info-subtle text-info px-2.5 py-1.5 rounded-pill border border-info-subtle">
                    <i class="bi bi-calendar-event me-1"></i> Upcoming
                  </span>
                <% } else if (el.statusTag === 'completed') { %>
                  <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5 rounded-pill border">
                    <i class="bi bi-check2-all me-1"></i> Attempts Completed
                  </span>
                <% } else { %>
                  <span class="badge bg-danger-subtle text-danger px-2.5 py-1.5 rounded-pill border border-danger-subtle">
                    <i class="bi bi-lock me-1"></i> <%= el.statusTag %>
                  </span>
                <% } %>
              </div>

              <div class="card-body p-4 d-flex flex-column">
                <div class="mb-2">
                  <span class="badge bg-light text-secondary border small"><%= exam.category %></span>
                  <% if (exam.courseId) { %>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle small ms-1"><%= exam.courseId.title %></span>
                  <% } %>
                </div>

                <h5 class="fw-bold text-dark mb-2"><%= exam.title %></h5>
                <p class="text-muted small flex-grow-1"><%= exam.description ? exam.description.slice(0, 110) + '...' : 'Comprehensive formal evaluation examination.' %></p>

                <!-- Exam Metrics Grid -->
                <div class="row g-2 p-2 bg-light rounded-3 my-3 small text-center">
                  <div class="col-4">
                    <div class="text-muted text-uppercase" style="font-size: 10px;">Duration</div>
                    <div class="fw-bold text-dark"><%= exam.durationMinutes %> min</div>
                  </div>
                  <div class="col-4 border-start border-end">
                    <div class="text-muted text-uppercase" style="font-size: 10px;">Total Marks</div>
                    <div class="fw-bold text-dark"><%= exam.totalMarks %></div>
                  </div>
                  <div class="col-4">
                    <div class="text-muted text-uppercase" style="font-size: 10px;">Pass Marks</div>
                    <div class="fw-bold text-dark"><%= exam.passingMarks %></div>
                  </div>
                </div>

                <!-- Attempts & Schedule Info -->
                <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                  <span>
                    <i class="bi bi-arrow-repeat me-1"></i> Attempts: <strong><%= el.attemptsCount || 0 %> / <%= exam.maxAttempts %></strong>
                  </span>
                  <span>
                    <% if (exam.availabilityMode === 'scheduled' && exam.startAt) { %>
                      <i class="bi bi-calendar3 me-1"></i> <%= new Date(exam.startAt).toLocaleDateString() %>
                    <% } else { %>
                      <i class="bi bi-infinity me-1"></i> Anytime
                    <% } %>
                  </span>
                </div>

                <!-- Action Button -->
                <div>
                  <% if (el.hasActiveAttempt) { %>
                    <a href="/exams/<%= exam.slug %>/runner" class="btn btn-warning w-100 fw-semibold rounded-3 shadow-sm">
                      <i class="bi bi-play-circle-fill me-1"></i> Resume Exam
                    </a>
                  <% } else if (el.eligible) { %>
                    <a href="/exams/<%= exam.slug %>" class="btn btn-primary w-100 fw-semibold rounded-3 shadow-sm">
                      <i class="bi bi-file-earmark-text me-1"></i> View Instructions & Start
                    </a>
                  <% } else { %>
                    <button class="btn btn-secondary w-100 fw-semibold rounded-3" disabled title="<%= el.reason %>">
                      <i class="bi bi-slash-circle me-1"></i> <%= el.reason %>
                    </button>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Section 2: Previous Attempts & Results History -->
  <% if (studentAttempts && studentAttempts.length > 0) { %>
    <div>
      <h4 class="fw-bold mb-3 text-dark">Your Examination History</h4>
      <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
          <table class="table align-middle mb-0">
            <thead class="table-light small text-secondary">
              <tr>
                <th class="ps-4">Examination</th>
                <th>Attempt #</th>
                <th>Date Taken</th>
                <th>Status</th>
                <th class="text-end pe-4">Result / Action</th>
              </tr>
            </thead>
            <tbody>
              <% studentAttempts.forEach(function(att) { %>
                <tr>
                  <td class="ps-4">
                    <div class="fw-semibold text-dark"><%= att.examinationId ? att.examinationId.title : 'Examination' %></div>
                    <div class="text-muted small">Version: <%= att.examVersion %></div>
                  </td>
                  <td>
                    <span class="badge bg-light text-dark border">Attempt <%= att.attemptNumber %></span>
                  </td>
                  <td class="small text-muted">
                    <%= new Date(att.startedAt).toLocaleString() %>
                  </td>
                  <td>
                    <% if (att.status === 'in_progress') { %>
                      <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i> In Progress</span>
                    <% } else if (att.status === 'submitted') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i> Submitted</span>
                    <% } else if (att.status === 'expired') { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-clock me-1"></i> Time Expired</span>
                    <% } else { %>
                      <span class="badge bg-secondary"><%= att.status %></span>
                    <% } %>
                  </td>
                  <td class="text-end pe-4">
                    <% if (att.status === 'in_progress') { %>
                      <a href="/exams/<%= att.examinationId.slug %>/runner" class="btn btn-sm btn-warning rounded-pill px-3">
                        Resume
                      </a>
                    <% } else { %>
                      <a href="/exams/results/<%= att._id %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="bi bi-eye me-1"></i> View Result
                      </a>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% } %>
</div>

