<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
          <li class="breadcrumb-item"><a href="/exams" class="text-decoration-none"><i class="bi bi-chevron-left me-1"></i>Back to Exams</a></li>
          <li class="breadcrumb-item active" aria-current="page">Result Summary</li>
        </ol>
      </nav>

      <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <!-- Header Banner -->
        <div class="card-header p-4 text-center <%= (result && result.isPassed) ? 'bg-success text-white' : (result && result.resultStatus === 'pending_evaluation' ? 'bg-primary text-white' : 'bg-dark text-white') %>">
          <div class="mb-2">
            <% if (result && result.resultStatus === 'pending_evaluation') { %>
              <i class="bi bi-hourglass-split display-4"></i>
            <% } else if (result && result.isPassed) { %>
              <i class="bi bi-trophy-fill display-4"></i>
            <% } else { %>
              <i class="bi bi-file-earmark-check display-4"></i>
            <% } %>
          </div>
          <h3 class="fw-bold mb-1"><%= exam.title %></h3>
          <p class="small mb-0 opacity-75">Attempt #<%= attempt.attemptNumber %> &bull; Submitted <%= new Date(attempt.submittedAt || attempt.updatedAt).toLocaleString() %></p>
        </div>

        <div class="card-body p-4 p-md-5">
          <!-- Status Alert -->
          <% if (result && result.resultStatus === 'pending_evaluation') { %>
            <div class="alert alert-info border-info d-flex align-items-center gap-3 rounded-3 mb-4">
              <i class="bi bi-info-circle-fill fs-3 text-info"></i>
              <div>
                <strong>Evaluation In Progress:</strong> Your submission contains subjective or descriptive questions that are currently being evaluated by the academic instructor. Final scores and certificate generation will be updated once grading is completed.
              </div>
            </div>
          <% } else if (result && result.isPassed) { %>
            <div class="alert alert-success border-success d-flex align-items-center gap-3 rounded-3 mb-4">
              <i class="bi bi-check-circle-fill fs-3 text-success"></i>
              <div>
                <strong>Congratulations!</strong> You have successfully passed this examination.
              </div>
            </div>
          <% } else if (result) { %>
            <div class="alert alert-warning border-warning d-flex align-items-center gap-3 rounded-3 mb-4">
              <i class="bi bi-exclamation-triangle-fill fs-3 text-warning"></i>
              <div>
                <strong>Assessment Completed:</strong> You did not achieve the required passing score for this attempt.
              </div>
            </div>
          <% } %>

          <!-- Score Card Metrics (if results are visible) -->
          <% if (canShowScores && result) { %>
            <div class="row g-3 mb-4 text-center">
              <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                  <div class="text-muted small text-uppercase">Obtained Marks</div>
                  <div class="fs-3 fw-bold text-primary"><%= result.obtainedMarks %> / <%= result.totalAvailableMarks %></div>
                </div>
              </div>
              <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                  <div class="text-muted small text-uppercase">Percentage</div>
                  <div class="fs-3 fw-bold text-dark"><%= result.percentage %>%</div>
                </div>
              </div>
              <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                  <div class="text-muted small text-uppercase">Pass Mark</div>
                  <div class="fs-3 fw-bold text-secondary"><%= exam.passingMarks %></div>
                </div>
              </div>
              <div class="col-sm-6 col-md-3">
                <div class="p-3 bg-light rounded-3 border">
                  <div class="text-muted small text-uppercase">Outcome</div>
                  <div class="fs-3 fw-bold <%= result.isPassed ? 'text-success' : 'text-danger' %>">
                    <%= result.isPassed ? 'PASSED' : (result.resultStatus === 'pending_evaluation' ? 'PENDING' : 'FAILED') %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Detailed Question Breakdown -->
            <div class="card border rounded-3 p-3 mb-4 bg-light">
              <div class="row text-center small text-secondary">
                <div class="col-3">
                  <span class="text-success fw-bold"><i class="bi bi-check-circle me-1"></i> Correct: <%= result.correctCount %></span>
                </div>
                <div class="col-3">
                  <span class="text-danger fw-bold"><i class="bi bi-x-circle me-1"></i> Incorrect: <%= result.incorrectCount %></span>
                </div>
                <div class="col-3">
                  <span class="text-muted fw-bold"><i class="bi bi-dash-circle me-1"></i> Unanswered: <%= result.unansweredCount %></span>
                </div>
                <div class="col-3">
                  <span class="text-primary fw-bold"><i class="bi bi-pencil me-1"></i> Pending Manual: <%= result.pendingManualCount %></span>
                </div>
              </div>
            </div>
          <% } else { %>
            <div class="text-center py-4 text-muted">
              <i class="bi bi-shield-lock fs-1 text-secondary"></i>
              <p class="mt-2 mb-0">Detailed scores will be released according to examination administration policies.</p>
            </div>
          <% } %>

          <!-- Student & Attempt Details Table -->
          <h6 class="fw-bold text-dark mb-3">Attempt Information</h6>
          <table class="table table-bordered small mb-4">
            <tbody>
              <tr>
                <th class="bg-light text-secondary" style="width: 35%;">Candidate Name</th>
                <td class="fw-semibold text-dark"><%= student.fullName %></td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">Student ID</th>
                <td class="font-mono text-dark"><%= student.officialStudentId || 'N/A' %></td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">Registered Email</th>
                <td class="text-dark"><%= student.email %></td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">Attempt Start Time</th>
                <td class="text-muted"><%= new Date(attempt.startedAt).toLocaleString() %></td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">Submission Time</th>
                <td class="text-muted"><%= new Date(attempt.submittedAt || attempt.updatedAt).toLocaleString() %></td>
              </tr>
              <tr>
                <th class="bg-light text-secondary">Attempt Status</th>
                <td>
                  <span class="badge bg-secondary"><%= attempt.status %></span>
                </td>
              </tr>
            </tbody>
          </table>

          <div class="d-flex justify-content-between align-items-center">
            <a href="/exams" class="btn btn-primary px-4 rounded-3">
              <i class="bi bi-arrow-left me-1"></i> Return to Examination Portal
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

