<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= course.title %> — Recorded Classes" />
  <meta name="theme-color" content="#1E40AF" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <title><%= title %></title>
</head>
<body class="course-page">
  <!-- Course Banner -->
  <div class="course-banner">
    <% if (course.thumbnail) { %>
      <img src="<%= course.thumbnail %>" alt="" class="course-banner-bg" />
    <% } %>
    <div class="course-banner-overlay">
      <div class="container">
        <div class="course-banner-content">
          <div class="brand-badge-light">
            <i class="bi bi-mortarboard"></i> Maths Manthra
          </div>
          <h1 class="course-title-banner"><%= course.title %></h1>
          <% if (course.description) { %>
            <p class="course-desc-banner"><%= course.description %></p>
          <% } %>
          <div class="course-meta-banner">
            <span><i class="bi bi-play-circle"></i> <%= videos.length %> Lessons</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Video List -->
  <div class="container">
    <div class="video-list-section">
      <h2 class="section-title">
        <i class="bi bi-collection-play"></i> All Lessons
      </h2>

      <% if (videos.length === 0) { %>
        <div class="empty-state-student">
          <i class="bi bi-hourglass-split"></i>
          <h4>No videos yet</h4>
          <p>Your teacher hasn't added any videos to this course yet. Check back soon!</p>
        </div>
      <% } else { %>
        <div class="video-list-student">
          <% videos.forEach((video, index) => { %>
            <a href="/course/<%= course.slug %>/watch/<%= video._id %>" class="video-card-student">
              <div class="video-card-thumb">
                <img src="/course/<%= course.slug %>/thumbnail/<%= video._id %>"
                     alt="<%= video.title %>" loading="lazy" />
                <div class="play-overlay">
                  <i class="bi bi-play-circle-fill"></i>
                </div>
              </div>
              <div class="video-card-body">
                <div class="day-label">Day <%= video.dayNumber %></div>
                <h3 class="video-card-title"><%= video.title %></h3>
                <% if (video.description) { %>
                  <p class="video-card-desc"><%= video.description.substring(0, 100) %><%= video.description.length > 100 ? '…' : '' %></p>
                <% } %>
              </div>
              <div class="video-card-arrow">
                <i class="bi bi-chevron-right"></i>
              </div>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Footer -->
  <footer class="course-footer">
    <div class="container">
      <p>📐 Maths Manthra — Private Recorded Classes</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Disable right click
    document.addEventListener('contextmenu', function(e) { e.preventDefault(); return false; });
    // Disable drag operations
    document.addEventListener('dragstart', function(e) { e.preventDefault(); return false; });
    // Disable text selection
    document.addEventListener('selectstart', function(e) { e.preventDefault(); return false; });
    // Disable devtools keyboard shortcuts
    document.addEventListener('keydown', function(e) {
      if (e.key === 'F12' || e.keyCode === 123) { e.preventDefault(); return false; }
      const isCtrlOrCmd = e.ctrlKey || e.metaKey;
      const isShiftOrAlt = e.shiftKey || e.altKey;
      const key = (e.key || '').toUpperCase();
      if (isCtrlOrCmd && isShiftOrAlt && (key === 'I' || key === 'J' || key === 'C')) { e.preventDefault(); return false; }
      if (isCtrlOrCmd && (key === 'U' || key === 'S')) { e.preventDefault(); return false; }
    });
  </script>
</body>
</html>
