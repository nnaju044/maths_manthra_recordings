<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= course.description ? course.description.substring(0, 160) : course.title %>" />
  <meta name="theme-color" content="#1E40AF" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <title><%= title %></title>
</head>
<body class="password-gate-page">
  <div class="password-gate-container">
    <div class="password-card">
      <!-- Course Thumbnail -->
      <div class="password-card-header">
        <% if (course.thumbnail) { %>
          <img src="<%= course.thumbnail %>" alt="<%= course.title %>" class="course-thumbnail-gate" />
        <% } else { %>
          <div class="course-thumbnail-placeholder">
            <i class="bi bi-book"></i>
          </div>
        <% } %>
      </div>

      <!-- Course Info -->
      <div class="password-card-body">
        <div class="brand-badge">
          <i class="bi bi-mortarboard"></i> Maths Manthra
        </div>
        <h1 class="course-title-gate"><%= course.title %></h1>
        <% if (course.description) { %>
          <p class="course-desc-gate"><%= course.description %></p>
        <% } %>

        <!-- Password Form -->
        <form action="/course/<%= course.slug %>/verify" method="POST" class="password-form" id="passwordForm">
          <label for="password" class="password-label">
            <i class="bi bi-lock"></i> Enter Course Password
          </label>

          <% if (error) { %>
            <div class="password-error">
              <i class="bi bi-exclamation-circle"></i> <%= error %>
            </div>
          <% } %>

          <div class="password-input-group">
            <input type="text" id="password" name="password"
                   class="password-input-field"
                   placeholder="● ● ● ●"
                   maxlength="4" inputmode="numeric" pattern="\d{4}"
                   autocomplete="off" autofocus required />
          </div>

          <button type="submit" class="btn-enter-course" id="submitBtn">
            <i class="bi bi-play-fill"></i> Access Course
          </button>
        </form>

        <div class="password-hint">
          <i class="bi bi-info-circle"></i> Ask your teacher for the 4-digit password
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Auto-submit when 4 digits entered
    const input = document.getElementById('password');
    const form = document.getElementById('passwordForm');
    input.addEventListener('input', function() {
      this.value = this.value.replace(/\D/g, '');
      if (this.value.length === 4) {
        document.getElementById('submitBtn').click();
      }
    });
  </script>
</body>
</html>
