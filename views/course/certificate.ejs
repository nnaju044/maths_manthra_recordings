<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="Request and verify your official course completion certificate — Maths Manthra Academy" />
  <meta name="theme-color" content="#1E40AF" />
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&family=Cinzel:wght@600;700;900&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="MathsManthra" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <title><%= title %></title>
  <style>
    .cert-hero {
      background: linear-gradient(135deg, #0F172A 0%, #1E3A8A 50%, #1E40AF 100%);
      color: #ffffff;
      padding: 36px 0 28px;
      text-align: center;
      position: relative;
    }
    .cert-hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #FDE68A;
      font-size: 0.8rem;
      font-weight: 600;
      padding: 6px 14px;
      border-radius: 30px;
      margin-bottom: 12px;
    }
    .cert-hero-title {
      font-size: 1.8rem;
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }
    .cert-card-wrap {
      max-width: 820px;
      margin: -20px auto 40px;
      padding: 0 16px;
      position: relative;
      z-index: 10;
    }
    .cert-card-container {
      background: #FFFFFF;
      border-radius: var(--radius-xl);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-xl);
      overflow: hidden;
    }
    .cert-display-box {
      background: radial-gradient(circle at center, #FFFFFF 0%, #F8FAFC 100%);
      border: 6px double #1E40AF;
      border-radius: 12px;
      padding: 32px 24px;
      position: relative;
      box-shadow: inset 0 0 20px rgba(30, 64, 175, 0.04);
    }
    .cert-seal {
      width: 64px;
      height: 64px;
      background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
      border-radius: 50%;
      color: #ffffff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.35);
      border: 3px solid #FEF3C7;
    }
    .cert-title-cinzel {
      font-family: 'Cinzel', serif;
      letter-spacing: 2px;
      color: #1E3A8A;
      font-weight: 700;
    }
    .cert-student-name {
      font-size: 1.7rem;
      font-weight: 800;
      color: #0F172A;
      border-bottom: 2px solid #E2E8F0;
      display: inline-block;
      padding-bottom: 4px;
      margin: 12px 0 6px;
    }
    .cert-course-name {
      font-size: 1.25rem;
      font-weight: 700;
      color: #1E40AF;
      margin-top: 4px;
    }
    .cert-meta-tag {
      background: #F1F5F9;
      border: 1px solid #CBD5E1;
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 0.85rem;
    }
    @media (max-width: 576px) {
      .cert-hero-title {
        font-size: 1.4rem;
      }
      .cert-display-box {
        padding: 24px 16px;
      }
      .cert-student-name {
        font-size: 1.3rem;
      }
    }
  </style>
</head>
<body class="bg-light">

  <!-- Top App Navigation -->
  <header class="bg-white border-bottom py-2 sticky-top">
    <div class="container d-flex align-items-center justify-content-between">
      <a href="/" class="d-flex align-items-center gap-2 text-dark text-decoration-none">
        <img src="/images/MM_Logo.jpg" alt="Maths Manthra Logo" style="width: 38px; height: 38px; border-radius: 6px; object-fit: cover;">
        <span class="fw-bold fs-5">Maths Manthra</span>
      </a>
      <div>
        <% if (selectedCourseSlug) { %>
          <a href="/course/<%= selectedCourseSlug %>/watch" class="btn btn-sm btn-outline-primary rounded-pill">
            <i class="bi bi-arrow-left"></i> Back to Lessons
          </a>
        <% } else { %>
          <a href="/auth/login" class="btn btn-sm btn-outline-secondary rounded-pill">
            Admin Login
          </a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- Hero Banner -->
  <section class="cert-hero">
    <div class="container">
      <div class="cert-hero-badge">
        <i class="bi bi-mortarboard-fill"></i> Official Student Portal
      </div>
      <h1 class="cert-hero-title">Course Certificate Portal</h1>
      <p class="text-white-50 mb-0 small">Verify, download, or submit your course completion certificate request.</p>
    </div>
  </section>

  <!-- Alerts -->
  <div class="container mt-3" style="max-width: 820px;">
    <%- include('../partials/alerts') %>
  </div>

  <!-- Main Card Wrapper -->
  <div class="cert-card-wrap">
    
    <!-- ═══════════════════════════════════════════════════════════════════════
         CASE 1: VERIFIED CERTIFICATE FOUND / DISPLAYED
         ═══════════════════════════════════════════════════════════════════════ -->
    <% if (student) { %>
      <div class="cert-card-container p-4 mb-4">
        
        <!-- Verification Success Banner -->
        <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-2 mb-4 rounded-3 border-0 bg-success-subtle text-success-emphasis no-print">
          <div class="d-flex align-items-center gap-2">
            <i class="bi bi-patch-check-fill fs-4 text-success"></i>
            <div>
              <strong>Verified Certificate Credential</strong>
              <div class="small">This certificate is verified by Maths Manthra Academy records.</div>
            </div>
          </div>
          <button onclick="window.print()" class="btn btn-sm btn-success rounded-pill px-3">
            <i class="bi bi-printer-fill me-1"></i> Print / Save PDF
          </button>
        </div>

        <!-- Official Certificate Frame -->
        <div class="cert-display-box text-center">
          <div class="cert-seal mb-3">
            <i class="bi bi-award-fill"></i>
          </div>

          <div class="cert-title-cinzel fs-6 text-uppercase mb-1">Maths Manthra Academy</div>
          <h2 class="cert-title-cinzel fs-3 mb-3">Certificate of Completion</h2>

          <p class="text-muted small mb-1">This is officially presented to</p>
          <div class="cert-student-name">
            <%= student.fullName || student.name %>
          </div>

          <% if (student.qualification) { %>
            <div class="text-muted small mb-2"><%= student.qualification %></div>
          <% } %>

          <p class="text-muted small mt-2 mb-1">for successfully completing all recorded lessons and coursework in</p>
          <div class="cert-course-name">
            <%= student.courseId ? student.courseId.title : 'Mathematics Program' %>
          </div>

          <!-- Metadata Badges -->
          <div class="d-flex align-items-center justify-content-center flex-wrap gap-3 mt-4 pt-3 border-top">
            <div class="cert-meta-tag">
              <span class="text-muted small">Certificate No:</span>
              <strong class="font-monospace text-primary ms-1"><%= student.certificateNumber %></strong>
            </div>
            <div class="cert-meta-tag">
              <span class="text-muted small">Issue Date:</span>
              <strong class="ms-1"><%= student.issuedDate ? new Date(student.issuedDate).toLocaleDateString() : new Date(student.createdAt).toLocaleDateString() %></strong>
            </div>
            <div class="cert-meta-tag text-success">
              <i class="bi bi-shield-fill-check"></i> Verified
            </div>
          </div>

          <!-- Signature / Verification Footer -->
          <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-4 pt-3 text-muted small">
            <div>
              <span class="text-dark fw-bold">📐 Maths Manthra</span> — Academic Certification
            </div>
            <div>
              Authenticity Verified via <code><%= appUrl %>/certificate?cert=<%= student.certificateNumber %></code>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mt-4 pt-3 border-top no-print">
          <a href="/certificate" class="btn btn-outline-secondary">
            <i class="bi bi-search"></i> Search Another Certificate
          </a>
          <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" onclick="navigator.clipboard.writeText(window.location.href); alert('Certificate link copied to clipboard!');">
              <i class="bi bi-share-fill"></i> Share Link
            </button>
            <button onclick="window.print()" class="btn btn-primary">
              <i class="bi bi-download"></i> Download / Print
            </button>
          </div>
        </div>

      </div>
    <% } %>

    <!-- ═══════════════════════════════════════════════════════════════════════
         CERTIFICATE SEARCH & REQUEST SECTION
         ═══════════════════════════════════════════════════════════════════════ -->
    <div class="cert-card-container p-4 no-print">
      
      <!-- Nav Tabs -->
      <ul class="nav nav-pills nav-fill mb-4 p-1 bg-light rounded-3" id="certTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= !student ? 'active fw-bold' : '' %>" id="tab-request" data-bs-toggle="tab" data-bs-target="#panel-request" type="button" role="tab">
            <i class="bi bi-file-earmark-plus"></i> Request Certificate
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link <%= student ? 'active fw-bold' : '' %>" id="tab-search" data-bs-toggle="tab" data-bs-target="#panel-search" type="button" role="tab">
            <i class="bi bi-search"></i> Verify / Look Up Certificate
          </button>
        </li>
      </ul>

      <div class="tab-content" id="certTabContent">
        
        <!-- ── TAB 1: REQUEST CERTIFICATE ── -->
        <div class="tab-pane fade <%= !student ? 'show active' : '' %>" id="panel-request" role="tabpanel">
          <div class="mb-3">
            <h4 class="fw-bold mb-1"><i class="bi bi-award text-primary"></i> Request Your Completion Certificate</h4>
            <p class="text-muted small">Enter your enrolled details to generate your certified completion credential.</p>
          </div>

          <form action="/certificate" method="POST" class="needs-validation">
            <input type="hidden" name="action" value="request" />

            <div class="row g-3">
              <!-- Full Name -->
              <div class="col-12 col-md-6">
                <label for="fullName" class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-person"></i></span>
                  <input type="text" id="fullName" name="fullName" class="form-control"
                         placeholder="Enter your name as on certificate" required maxlength="100" />
                </div>
                <div class="form-text">Will be printed on your official certificate.</div>
              </div>

              <!-- Email -->
              <div class="col-12 col-md-6">
                <label for="email" class="form-label fw-semibold">Email Address <span class="text-danger">*</span></label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                  <input type="email" id="email" name="email" class="form-control"
                         placeholder="student@example.com" required />
                </div>
                <div class="form-text">Used to locate your student records.</div>
              </div>

              <!-- Course Selection -->
              <div class="col-12 col-md-6">
                <label for="courseId" class="form-label fw-semibold">Completed Course <span class="text-danger">*</span></label>
                <select id="courseId" name="courseId" class="form-select" required>
                  <option value="">-- Choose Completed Course --</option>
                  <% courses.forEach(c => { %>
                    <option value="<%= c._id %>" <%= (selectedCourse && selectedCourse._id.toString() === c._id.toString()) ? 'selected' : '' %>>
                      <%= c.title %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <!-- Phone -->
              <div class="col-12 col-md-6">
                <label for="phone" class="form-label fw-semibold">Phone Number</label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                  <input type="tel" id="phone" name="phone" class="form-control"
                         placeholder="+91 98765 43210" />
                </div>
              </div>

              <!-- Qualification -->
              <div class="col-12">
                <label for="qualification" class="form-label fw-semibold">Qualification / Class (Optional)</label>
                <input type="text" id="qualification" name="qualification" class="form-control"
                       placeholder="e.g. Class 10, Class 12, B.Sc Mathematics" />
              </div>
            </div>

            <!-- Submit Button -->
            <div class="mt-4 pt-2">
              <button type="submit" class="btn btn-primary btn-lg w-100 py-2 fw-semibold">
                🎓 Generate & Obtain Certificate
              </button>
            </div>
          </form>
        </div>

        <!-- ── TAB 2: SEARCH / VERIFY ── -->
        <div class="tab-pane fade <%= student ? 'show active' : '' %>" id="panel-search" role="tabpanel">
          <div class="mb-3">
            <h4 class="fw-bold mb-1"><i class="bi bi-search text-primary"></i> Search Existing Certificate</h4>
            <p class="text-muted small">Verify a certificate by student email or certificate identification number.</p>
          </div>

          <form action="/certificate" method="POST">
            <input type="hidden" name="action" value="search" />

            <div class="mb-3">
              <label for="query" class="form-label fw-semibold">Email or Certificate Number</label>
              <div class="input-group input-group-lg">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" id="query" name="query" class="form-control"
                       placeholder="e.g. MMC-2026-XXXX or your email"
                       value="<%= searchTerm %>" required />
                <button type="submit" class="btn btn-primary px-4">
                  Verify
                </button>
              </div>
              <div class="form-text">Example certificate number format: <code>MMC-2026-XXXX-XXXX</code></div>
            </div>
          </form>

          <div class="p-3 bg-light rounded-3 mt-4 text-muted small">
            <i class="bi bi-info-circle text-primary"></i> All certificates generated by Maths Manthra Academy are digitally signed and verifiable online anytime.
          </div>
        </div>

      </div>

    </div>

  </div>

  <!-- Footer -->
  <footer class="py-4 text-center text-muted small border-top bg-white no-print">
    <div class="container">
      <p class="mb-0">📐 Maths Manthra Academy — Private Recorded Classes Portal</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // PWA: Register Service Worker
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function() {
        navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(function() {});
      });
    }
  </script>
</body>
</html>
