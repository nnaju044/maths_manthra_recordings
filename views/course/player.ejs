<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content="<%= video.title %> — <%= course.title %>" />
  <meta name="theme-color" content="#0F172A" />
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/images/favicon.ico" type="image/x-icon" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link rel="stylesheet" href="/css/main.css" />
  <!-- PWA -->
  <link rel="manifest" href="/manifest.json" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="MathsManthra" />
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
  <title><%= title %></title>
</head>
<body class="player-page has-bottom-nav" data-player-slug="<%= course.slug %>" data-current-video-id="<%= video._id %>">

  <!-- Mobile App Player Navigation Bar -->
  <header class="app-player-nav">
    <div class="player-nav-inner">
      <a href="/course/<%= course.slug %>/watch" class="player-nav-back" aria-label="Return to course lessons">
        <i class="bi bi-chevron-left"></i>
        <span class="d-none d-sm-inline"><%= course.title %></span>
        <span class="d-sm-none">All Lessons</span>
      </a>

      <!-- Progress Pill -->
      <div class="player-nav-progress">
        <span class="badge-lesson-counter">
          <i class="bi bi-collection-play"></i> Day <%= video.dayNumber %> (<%= currentIndex %>/<%= totalVideos %>)
        </span>
      </div>
    </div>
    
    <!-- Thin Course Progress Bar at Bottom of App Bar -->
    <div class="player-progress-bar-track">
      <div class="player-progress-bar-fill" style="width: <%= totalVideos > 0 ? Math.round((currentIndex / totalVideos) * 100) : 0 %>%;"></div>
    </div>
  </header>

  <!-- Large Video Player Section -->
  <section id="playerContainer" class="player-container">
    <div class="player-wrapper">
      <!-- Shield overlay across the top to intercept clicks on YouTube header (Title, Watch Later, Share) -->
      <div class="player-top-shield" title="Maths Manthra Player"></div>

      <iframe
        id="mathsManthraPlayer"
        src="<%= embedUrl %>"
        title="<%= video.title %>"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
        sandbox="allow-scripts allow-same-origin allow-presentation allow-forms"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>

      <!-- Permanent Watermark — Bottom Left Corner -->
      <div class="player-watermark" aria-hidden="true">
        <span class="watermark-icon">📐</span>
        <span class="watermark-text">Maths Manthra</span>
      </div>
    </div>
  </section>

  <!-- Video Details & Actions -->
  <main class="container py-3">
    <div class="player-info-section">
      <!-- Anti-sharing Security Warning -->
      <div class="anti-sharing-warning" role="alert">
        <i class="bi bi-shield-lock-fill"></i>
        <span>Enrolled student access. Unauthorized recording or sharing is strictly prohibited.</span>
      </div>

      <!-- Quick Action Bar: Day Pill + Complete Toggle -->
      <div class="player-meta-bar d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <div class="d-flex align-items-center gap-2">
          <span class="player-day-badge mb-0">Day <%= video.dayNumber %></span>
          <span class="player-lesson-pill text-muted">Lesson <%= currentIndex %> of <%= totalVideos %></span>
        </div>
        
        <!-- Interactive Progress Toggle -->
        <button id="btnToggleComplete" type="button" class="btn-complete-toggle" aria-label="Toggle lesson completion">
          <i id="completeStatusIcon" class="bi bi-check-circle"></i>
          <span id="completeStatusText">Mark as Completed</span>
        </button>
      </div>

      <h1 class="player-title"><%= video.title %></h1>
      
      <% if (video.description) { %>
        <p class="player-description"><%= video.description %></p>
      <% } %>

      <!-- Course Certificate Section -->
      <section class="app-certificate-card mb-4" aria-label="Course Certificate">
        <div class="certificate-card-inner">
          <div class="certificate-card-content">
            <div class="certificate-badge">
              <i class="bi bi-patch-check-fill text-warning"></i>
              <span>Official Certification</span>
            </div>
            <h4 class="certificate-card-title mb-1">Get Your Course Certificate</h4>
            <p class="certificate-card-subtext mb-0">
              Finished studying all lessons? Verify your completion and download your certificate.
            </p>
          </div>
          <div class="certificate-card-action">
            <a href="/certificate?course=<%= course.slug %>" class="btn-get-certificate" id="btnGetPlayerCertificate">
              🎓 Get Certificate
            </a>
          </div>
        </div>
      </section>

      <!-- PDF Notes Section -->
      <section id="notesSection" class="app-notes-section mb-4">
        <% if (video.pdfUrl) { %>
          <div class="app-notes-card">
            <div class="notes-header d-flex align-items-start gap-3 mb-3">
              <div class="notes-icon-box">
                <i class="bi bi-file-earmark-pdf-fill"></i>
              </div>
              <div class="notes-title-wrap">
                <div class="notes-badge">Study Material</div>
                <h4 class="notes-title mb-1"><%= video.pdfTitle || 'Lesson Notes & Formulas' %></h4>
                <p class="notes-subtext mb-0">Reference notes and solution sheets prepared for Day <%= video.dayNumber %>.</p>
              </div>
            </div>
            <div class="notes-actions d-flex gap-2 flex-wrap">
              <a href="<%= video.pdfUrl %>" target="_blank" rel="noopener noreferrer"
                 class="btn-note-view">
                <i class="bi bi-eye-fill"></i> View Notes
              </a>
              <a href="<%= getDriveDownloadUrl(video.pdfUrl) %>" target="_blank" rel="noopener noreferrer"
                 class="btn-note-download">
                <i class="bi bi-cloud-arrow-down-fill"></i> Download Notes
              </a>
            </div>
          </div>
        <% } else { %>
          <div class="app-notes-card no-notes">
            <div class="d-flex align-items-center gap-2 text-muted">
              <i class="bi bi-file-earmark-x"></i>
              <span>No PDF notes attached for this lesson.</span>
            </div>
          </div>
        <% } %>
      </section>

      <!-- Previous / Next Navigation Buttons -->
      <div class="player-navigation mb-4">
        <% if (prevVideo) { %>
          <a href="/course/<%= course.slug %>/watch/<%= prevVideo._id %>" class="nav-btn prev-btn">
            <i class="bi bi-chevron-left"></i>
            <div class="nav-btn-text">
              <span class="nav-label">Previous Lesson</span>
              <span class="nav-title">Day <%= prevVideo.dayNumber %> — <%= prevVideo.title %></span>
            </div>
          </a>
        <% } else { %>
          <div class="nav-btn-spacer"></div>
        <% } %>

        <% if (nextVideo) { %>
          <a href="/course/<%= course.slug %>/watch/<%= nextVideo._id %>" class="nav-btn next-btn">
            <div class="nav-btn-text">
              <span class="nav-label">Next Lesson</span>
              <span class="nav-title">Day <%= nextVideo.dayNumber %> — <%= nextVideo.title %></span>
            </div>
            <i class="bi bi-chevron-right"></i>
          </a>
        <% } else { %>
          <div class="nav-btn-spacer"></div>
        <% } %>
      </div>

      <!-- Back to Course Link -->
      <div class="back-to-course">
        <a href="/course/<%= course.slug %>/watch">
          <i class="bi bi-grid-fill"></i> View All Course Lessons
        </a>
      </div>
    </div>
  </main>

  <!-- Course Footer -->
  <footer class="course-footer">
    <div class="container">
      <p>📐 Maths Manthra — Private Recorded Classes</p>
    </div>
  </footer>

  <!-- Fixed Bottom Navigation Bar -->
  <nav class="app-bottom-nav app-bottom-nav-dark" aria-label="Student Player Navigation">
    <a href="/course/<%= course.slug %>/watch" class="bottom-nav-item">
      <i class="bi bi-grid-fill bottom-nav-icon"></i>
      <span class="bottom-nav-label">Lessons</span>
    </a>
    <a href="#playerContainer" class="bottom-nav-item active">
      <i class="bi bi-play-circle-fill bottom-nav-icon"></i>
      <span class="bottom-nav-label">Player</span>
    </a>
    <% if (video.pdfUrl) { %>
      <a href="#notesSection" class="bottom-nav-item">
        <i class="bi bi-file-earmark-pdf-fill bottom-nav-icon"></i>
        <span class="bottom-nav-label">Notes</span>
      </a>
    <% } else { %>
      <div class="bottom-nav-item disabled" title="No notes for this lesson">
        <i class="bi bi-file-earmark bottom-nav-icon"></i>
        <span class="bottom-nav-label">Notes</span>
      </div>
    <% } %>
    <% if (nextVideo) { %>
      <a href="/course/<%= course.slug %>/watch/<%= nextVideo._id %>" class="bottom-nav-item">
        <i class="bi bi-skip-forward-fill bottom-nav-icon"></i>
        <span class="bottom-nav-label">Next</span>
      </a>
    <% } else { %>
      <div class="bottom-nav-item disabled" title="Course Completed!">
        <i class="bi bi-check-circle bottom-nav-icon"></i>
        <span class="bottom-nav-label">Finished</span>
      </div>
    <% } %>
  </nav>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
  <script>
    // 1. Disable Right Click (Context Menu)
    document.addEventListener('contextmenu', function(e) {
      e.preventDefault();
      return false;
    });

    // 2. Disable Text Selection
    document.addEventListener('selectstart', function(e) {
      e.preventDefault();
      return false;
    });

    // 3. Disable Drag Operations
    document.addEventListener('dragstart', function(e) {
      e.preventDefault();
      return false;
    });

    // 4. Disable Common Inspect & DevTools Shortcuts
    document.addEventListener('keydown', function(e) {
      // F12
      if (e.key === 'F12' || e.keyCode === 123) {
        e.preventDefault();
        return false;
      }

      const isCtrlOrCmd = e.ctrlKey || e.metaKey;
      const isShiftOrAlt = e.shiftKey || e.altKey;
      const key = (e.key || '').toUpperCase();

      // Ctrl+Shift+I / Cmd+Option+I (Inspect)
      // Ctrl+Shift+J / Cmd+Option+J (Console)
      // Ctrl+Shift+C / Cmd+Option+C (Inspect Element)
      if (isCtrlOrCmd && isShiftOrAlt && (key === 'I' || key === 'J' || key === 'C')) {
        e.preventDefault();
        return false;
      }

      // Ctrl+U / Cmd+U (View Source)
      if (isCtrlOrCmd && key === 'U') {
        e.preventDefault();
        return false;
      }

      // Ctrl+S / Cmd+S (Save Page)
      if (isCtrlOrCmd && key === 'S') {
        e.preventDefault();
        return false;
      }
    });

    // Absorb clicks on top shield
    const topShield = document.querySelector('.player-top-shield');
    if (topShield) {
      topShield.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
      });
    }
  </script>
  <script>
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js')
          .catch(err => console.error('SW registration failed:', err));
      });
    }
  </script>
</body>
</html>
