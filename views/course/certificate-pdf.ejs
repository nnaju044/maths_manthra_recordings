<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <style>
    /* ── Reset ── */
    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    @page {
      size: A4 landscape;
      margin: 0;
    }

    html,
    body {
      width: 297mm;
      height: 210mm;
      margin: 0;
      padding: 0;
      overflow: hidden;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    /* ── Certificate container — exact A4 landscape ── */
    .certificate-container {
      width: 297mm;
      height: 210mm;
      position: relative;
      overflow: hidden;
    }

    .certificate-background {
      position: relative;
      width: 100%;
      height: 100%;
      font-size: 14px;
    }

    .certificate-background img.cert-bg-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: fill;
      display: block;
    }

    .certificate-overlay {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    /* ── Shared overlay field ── */
    .cert-field {
      position: absolute;
      transform: translateX(-50%);
      white-space: nowrap;
      line-height: 1.2;
    }

    /* ── QR code ── */
    .cert-field--qr {
      left: 20.7mm;
      top: 64.0mm;
      width: 36.0mm;
      height: 36.0mm;
      transform: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .cert-field--qr img,
    .cert-field--qr svg {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    /* ── Student Name ── */
    .cert-field--name {
      position: absolute;
      left: 148.5mm;
      top: 108.5mm;
      transform: translate(-50%, -100%);
      font-family: 'Brush Script MT', 'Segoe Script', cursive, 'Georgia', serif;
      font-size: 2.8em;
      font-weight: 700;
      color: #0b1f3a;
      white-space: nowrap;
      text-align: center;
      line-height: 1;
    }

    /* ── Date (left signature line) ── */
    .cert-field--date {
      left: 93.6mm;
      top: 151.8mm;
      transform: translate(-50%, -100%);
      font-family: Arial, sans-serif;
      font-size: 0.78em;
      font-weight: 600;
      color: #1a1a2e;
      text-align: center;
      white-space: nowrap;
      line-height: 1;
    }

    /* ── Signature image ── */
    .cert-field--signature {
      left: 201.7mm;
      top: 154.5mm;
      width: 44mm;
      transform: translate(-50%, -100%);
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
    }

    .cert-field--signature img {
      width: 100%;
      height: auto;
      object-fit: contain;
    }

    /* ── Certificate ID ── */
    .cert-field--cert-id {
      left: 44.5mm;
      top: 173.4mm;
      transform: none;
      font-family: 'Courier New', monospace;
      font-size: 0.72em;
      font-weight: 700;
      color: #0b1f3a;
      line-height: 1.2;
    }

    /* ── Date of Completion ── */
    .cert-field--completion-date {
      left: 53.5mm;
      top: 180.8mm;
      transform: none;
      font-family: Arial, sans-serif;
      font-size: 0.72em;
      font-weight: 600;
      color: #0b1f3a;
      line-height: 1.2;
    }

    /* ── Verification URL ── */
    .cert-field--verify-url {
      left: 50%;
      top: 92.5%;
      transform: translateX(-50%);
      font-family: Arial, sans-serif;
      font-size: 0.55em;
      color: #4b5563;
      text-align: center;
      white-space: normal;
      width: 60%;
    }
  </style>
</head>

<body>
  <div class="certificate-container">
    <div class="certificate-background">

      <!-- Background image (absolute path for Puppeteer file:// access) -->
      <img class="cert-bg-img" src="<%= bgImagePath %>" alt="MathsManthra Certificate of Completion" />

      <div class="certificate-overlay">

        <!-- QR Code -->
        <div class="cert-field cert-field--qr">
          <%- qrCode %>
        </div>

        <!-- Student Name -->
        <div class="cert-field cert-field--name">
          <%= studentName %>
        </div>

        <!-- Issued Date (left signature line) -->
        <div class="cert-field cert-field--date">
          <%= issuedDate %>
        </div>

        <!-- Signature Image -->
        <div class="cert-field cert-field--signature">
          <img src="<%= signaturePath %>" alt="Director Signature" />
        </div>

        <!-- Certificate ID -->
        <div class="cert-field cert-field--cert-id">
          <%= certificateNumber %>
        </div>

        <!-- Date of Completion (footer row) -->
        <div class="cert-field cert-field--completion-date">
          <%= completionDate %>
        </div>

      </div><!-- /.certificate-overlay -->
    </div><!-- /.certificate-background -->
  </div><!-- /.certificate-container -->
</body>

</html>