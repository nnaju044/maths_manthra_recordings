<!-- views/admin/certificates/upload.ejs -->
<div class="content-header">
  <div>
    <h2><i class="bi bi-file-earmark-arrow-up text-primary"></i> Upload Certificate Students</h2>
    <p class="text-muted mb-0">Import student records from an Excel spreadsheet to issue verified course certificates.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/certificates" class="btn btn-outline-secondary">
      <i class="bi bi-people"></i> View Student List
    </a>
  </div>
</div>

<!-- Import Results Summary Banner (if just imported) -->
<% if (importResult) { %>
  <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px; overflow: hidden; background: #ffffff;">
    <div class="card-header bg-white border-bottom py-3 d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
          <i class="bi bi-check2-circle"></i> Import Summary
        </span>
        <strong class="text-dark"><%= importResult.courseTitle %></strong>
      </div>
      <small class="text-muted"><%= importResult.totalRows %> total row(s) in sheet</small>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <!-- Imported Count Card -->
        <div class="col-12 col-md-6">
          <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background: #f0fdf4; border: 1px solid #bbf7d0;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; background: #22c55e; color: #fff; font-size: 1.4rem;">
                <i class="bi bi-person-check-fill"></i>
              </div>
              <div>
                <div class="text-muted small fw-medium">Imported Count</div>
                <div class="h3 mb-0 fw-bold text-success"><%= importResult.importedCount %></div>
              </div>
            </div>
            <span class="badge bg-success text-white px-3 py-2 rounded-pill">Successfully Added</span>
          </div>
        </div>

        <!-- Skipped Count Card -->
        <div class="col-12 col-md-6">
          <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background: #fffbeb; border: 1px solid #fde68a;">
            <div class="d-flex align-items-center gap-3">
              <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 46px; height: 46px; background: #f59e0b; color: #fff; font-size: 1.4rem;">
                <i class="bi bi-person-dash-fill"></i>
              </div>
              <div>
                <div class="text-muted small fw-medium">Skipped Count</div>
                <div class="h3 mb-0 fw-bold text-warning" style="color: #d97706 !important;"><%= importResult.skippedCount %></div>
              </div>
            </div>
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill">Duplicates / Invalid</span>
          </div>
        </div>
      </div>

      <div class="mt-3 pt-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
        <small class="text-muted">
          <i class="bi bi-info-circle"></i> Duplicate emails for the same course were automatically skipped to avoid double certification.
        </small>
        <a href="/admin/certificates" class="btn btn-sm btn-primary">
          <i class="bi bi-arrow-right-circle"></i> Open Student List
        </a>
      </div>
    </div>
  </div>
<% } %>

<!-- Upload Form Card -->
<div class="form-card">
  <form action="/admin/certificates/upload" method="POST" enctype="multipart/form-data" class="admin-form" id="excelUploadForm">

    <!-- Step 1: Select Course -->
    <div class="mb-4">
      <label for="courseId" class="form-label fw-semibold">
        1. Select Course <span class="text-danger">*</span>
      </label>
      <select name="courseId" id="courseId" class="form-select form-select-lg" required>
        <option value="">-- Choose Course to Issue Certificates --</option>
        <% courses.forEach(course => { %>
          <option value="<%= course._id %>">
            <%= course.title %> <%= !course.isActive ? '(Inactive)' : '' %>
          </option>
        <% }) %>
      </select>
      <div class="form-text">
        Certificates will be attached to this course. Unique certificate numbers will be generated automatically.
      </div>
    </div>

    <!-- Step 2: Upload Excel File -->
    <div class="mb-4">
      <label for="file" class="form-label fw-semibold">
        2. Upload Excel File (.xlsx) <span class="text-danger">*</span>
      </label>
      <input type="file" id="file" name="file" class="form-control form-control-lg"
             accept=".xlsx, .xls, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
             required />
      <div class="form-text">
        Accepts standard <code>.xlsx</code> or <code>.xls</code> spreadsheet formats. Maximum size: 10MB.
      </div>
    </div>

    <!-- Expected Column Mapping Reference Box -->
    <div class="card border-0 bg-light rounded-3 p-3 mb-4">
      <h6 class="fw-bold mb-2 text-secondary d-flex align-items-center gap-2">
        <i class="bi bi-table"></i> Expected Excel Columns Format:
      </h6>
      <div class="table-responsive">
        <table class="table table-sm table-bordered bg-white mb-2 small text-nowrap">
          <thead class="table-light">
            <tr>
              <th>Timestamp</th>
              <th class="text-primary fw-bold">Full name *</th>
              <th class="text-primary fw-bold">Email *</th>
              <th>phone</th>
              <th>Qualification</th>
              <th>Your picture</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="text-muted">2026/09/22 10:15:00</td>
              <td>John Doe</td>
              <td>john@example.com</td>
              <td>+91 9876543210</td>
              <td>B.Sc Mathematics</td>
              <td class="text-muted">https://... or photo link</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="small text-muted d-flex flex-wrap gap-3">
        <span><i class="bi bi-shield-check text-success"></i> <strong>Full name</strong> & <strong>Email</strong> are required per student.</span>
        <span><i class="bi bi-funnel text-primary"></i> Duplicate emails for the selected course are automatically skipped.</span>
        <span><i class="bi bi-hash text-info"></i> Unique Certificate Numbers are auto-generated.</span>
      </div>
    </div>

    <!-- Submit Button -->
    <div class="d-flex align-items-center gap-3">
      <button type="submit" class="btn btn-primary btn-lg px-4" id="submitBtn">
        <i class="bi bi-cloud-arrow-up-fill"></i> Import Students
      </button>
      <a href="/admin/certificates" class="btn btn-outline-secondary btn-lg">
        Cancel
      </a>
    </div>

  </form>
</div>

<script>
  // Simple form loading state
  const form = document.getElementById('excelUploadForm');
  const submitBtn = document.getElementById('submitBtn');
  if (form && submitBtn) {
    form.addEventListener('submit', function() {
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Processing Excel...';
    });
  }
</script>
