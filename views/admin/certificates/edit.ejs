<!-- views/admin/certificates/edit.ejs -->
<div class="content-header">
  <div>
    <h2><i class="bi bi-pencil-square text-primary"></i> Edit Student</h2>
    <p class="text-muted mb-0">
      Editing: <strong>
        <%= student.fullName || student.name %>
      </strong>
      <% if (student.studentId) { %>
        <span class="badge bg-light text-primary border font-monospace ms-2">
          <%= student.studentId %>
        </span>
        <% } %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/certificates" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back to Students
    </a>
  </div>
</div>

<div class="form-card">
  <form action="/admin/certificates/<%= student._id %>/update" method="POST" class="admin-form" id="editStudentForm">

    <!-- Row 1: Name + Email -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="fullName" class="form-label fw-semibold">
          Student Name <span class="text-danger">*</span>
        </label>
        <input type="text" id="fullName" name="fullName" class="form-control form-control-lg"
          value="<%= student.fullName || student.name %>" required />
      </div>
      <div class="col-12 col-md-6">
        <label for="email" class="form-label fw-semibold">
          Email <span class="text-danger">*</span>
        </label>
        <input type="email" id="email" name="email" class="form-control form-control-lg" value="<%= student.email %>"
          required />
      </div>
    </div>

    <!-- Row 2: Phone + Qualification -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="phone" class="form-label fw-semibold">Phone Number</label>
        <input type="text" id="phone" name="phone" class="form-control" value="<%= student.phone || '' %>" />
      </div>
      <div class="col-12 col-md-6">
        <label for="qualification" class="form-label fw-semibold">Qualification</label>
        <input type="text" id="qualification" name="qualification" class="form-control"
          value="<%= student.qualification || '' %>" />
      </div>
    </div>

    <!-- Row 3: Course + Student ID -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="courseId" class="form-label fw-semibold">
          Course <span class="text-danger">*</span>
        </label>
        <select name="courseId" id="courseId" class="form-select form-select-lg" required>
          <option value="">-- Select Course --</option>
          <% courses.forEach(course=> { %>
            <option value="<%= course._id %>" <%=student.courseId &&
              student.courseId._id.toString()===course._id.toString() ? 'selected' : '' %>>
              <%= course.title %>
                <%= !course.isActive ? '(Inactive)' : '' %>
            </option>
            <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-6">
        <label for="studentId" class="form-label fw-semibold">Student ID</label>
        <input type="text" id="studentId" name="studentId" class="form-control"
          value="<%= student.studentId || '' %>" />
      </div>
    </div>

    <!-- Row 4: Certificate Number + Issued Date (read-only reference) -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="certificateNumber" class="form-label fw-semibold">Certificate Number</label>
        <input type="text" id="certificateNumber" name="certificateNumber" class="form-control font-monospace"
          value="<%= student.certificateNumber || '' %>" />
        <div class="form-text">Auto-generated. Edit only if you need to change it.</div>
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label fw-semibold">Issued Date</label>
        <input type="text" class="form-control" disabled
          value="<%= student.issuedDate ? new Date(student.issuedDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Not set' %>" />
      </div>
    </div>

    <!-- Row 5: Verification Status -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="verificationStatus" class="form-label fw-semibold">Verification Status</label>
        <select name="verificationStatus" id="verificationStatus" class="form-select">
          <option value="true" <%=student.verificationStatus !==false ? 'selected' : '' %>>Verified</option>
          <option value="false" <%=student.verificationStatus===false ? 'selected' : '' %>>Not Verified</option>
        </select>
      </div>
    </div>

    <!-- Row 6: Profile Image URL -->
    <div class="mb-3">
      <label for="profileImage" class="form-label fw-semibold">Profile Image URL</label>
      <div class="d-flex align-items-start gap-3">
        <div class="flex-grow-1">
          <input type="url" id="profileImage" name="profileImage" class="form-control"
            value="<%= student.profileImage || '' %>" />
        </div>
        <% if (student.profileImage && (student.profileImage.startsWith('http://') ||
          student.profileImage.startsWith('https://'))) { %>
          <img src="<%= student.profileImage %>" alt="Profile" class="rounded-circle"
            style="width: 48px; height: 48px; object-fit: cover; border: 2px solid #e5e7eb;"
            onerror="this.style.display='none'" />
          <% } %>
      </div>
    </div>

    <!-- Row 7: Progress Card (textarea) -->
    <div class="mb-4">
      <label for="progressCard" class="form-label fw-semibold">Progress Card</label>
      <textarea id="progressCard" name="progressCard" class="form-control" rows="5"
        placeholder="Detailed student progress report, performance summary, or remarks..."><%= student.progressCard || '' %></textarea>
      <div class="form-text">
        Supports long paragraphs — e.g. course completion summary, achievements, areas of strength.
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         PROGRESS REPORT SECTION
         ═══════════════════════════════════════════════════════════ -->
    <div class="card border border-primary-subtle shadow-sm mb-4 bg-light-subtle rounded-3 overflow-hidden">
      <div
        class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-2">
            <i class="bi bi-file-earmark-bar-graph-fill fs-5"></i>
          </div>
          <div>
            <h5 class="mb-0 fw-bold text-dark">PROGRESS REPORT</h5>
            <small class="text-muted">Comprehensive weekly and final academic assessment metrics</small>
          </div>
        </div>
        <span class="badge bg-primary px-3 py-2 rounded-pill">Evaluation Details</span>
      </div>

      <div class="card-body p-3 p-md-4">

        <!-- SECTION 1: WEEKLY PERFORMANCE EVALUATION -->
        <div class="mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-calendar4-week text-primary fw-bold fs-5"></i>
              <h6 class="mb-0 fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">
                Weekly Performance Evaluation
              </h6>
            </div>
            <span class="badge bg-light text-secondary border px-2.5 py-1.5 small">
              <i class="bi bi-info-circle me-1"></i> Marks: 0 to 5 per criteria (Max Total: 40)
            </span>
          </div>

          <!-- 4 Weeks Modern Grid Layout -->
          <div class="row g-3 row-cols-1 row-cols-md-2 row-cols-xl-4 mb-3">
            <% const wpData = (typeof weeklyPerformance !== 'undefined' && weeklyPerformance) ? weeklyPerformance : (student.weeklyPerformance || {}); %>
            <% [1, 2, 3, 4].forEach(function(w) { 
                 const weekKey = 'week' + w;
                 const weekItem = wpData[weekKey] || (student[weekKey] ? {
                   assignmentHomework: typeof student[weekKey].assignmentHomework === 'number' ? student[weekKey].assignmentHomework : parseFloat(student[weekKey].assignmentHomework) || 0,
                   activityEngagement: typeof student[weekKey].activityEngagement === 'number' ? student[weekKey].activityEngagement : parseFloat(student[weekKey].activityEngagement) || 0
                 } : { assignmentHomework: 0, activityEngagement: 0 });
                 const ah = (typeof weekItem.assignmentHomework === 'number' && !isNaN(weekItem.assignmentHomework)) ? weekItem.assignmentHomework : (parseFloat(weekItem.assignmentHomework) || 0);
                 const ae = (typeof weekItem.activityEngagement === 'number' && !isNaN(weekItem.activityEngagement)) ? weekItem.activityEngagement : (parseFloat(weekItem.activityEngagement) || 0);
                 const wTotal = Math.min(10, Math.max(0, ah + ae));
            %>
              <div class="col">
                <div class="card h-100 border border-slate-200 shadow-sm rounded-3 bg-white">
                  <div class="card-header bg-light py-2 px-3 border-bottom d-flex align-items-center justify-content-between">
                    <span class="fw-bold text-dark d-flex align-items-center gap-1.5">
                      <span class="badge bg-primary px-2 py-1">Week <%= w %></span>
                    </span>
                    <span class="badge bg-white text-primary border border-primary-subtle px-2 py-1 font-monospace" id="week<%= w %>TotalBadge">
                      Week <%= w %> Total: <strong id="week<%= w %>TotalVal"><%= wTotal %></strong> / 10
                    </span>
                  </div>
                  <div class="card-body p-3 d-flex flex-column gap-3">
                    <!-- Assignment / Homework -->
                    <div>
                      <div class="d-flex align-items-center justify-content-between mb-1">
                        <label for="w<%= w %>_ah" class="form-label small fw-semibold text-secondary mb-0">
                          Assignment / Homework
                        </label>
                        <span class="badge bg-light text-muted border px-1.5 py-0.5" style="font-size: 0.7rem;">0 - 5</span>
                      </div>
                      <div class="input-group input-group-sm">
                        <input type="number" 
                               id="w<%= w %>_ah" 
                               name="weeklyPerformance[week<%= w %>][assignmentHomework]" 
                               class="form-control weekly-perf-input text-end font-monospace fw-semibold" 
                               data-week="<%= w %>"
                               data-type="ah"
                               min="0" 
                               max="5" 
                               step="0.5" 
                               placeholder="0" 
                               value="<%= ah %>" 
                               required />
                        <span class="input-group-text bg-light text-muted">/ 5</span>
                      </div>
                    </div>

                    <!-- Activity / Engagement -->
                    <div>
                      <div class="d-flex align-items-center justify-content-between mb-1">
                        <label for="w<%= w %>_ae" class="form-label small fw-semibold text-secondary mb-0">
                          Activity / Engagement
                        </label>
                        <span class="badge bg-light text-muted border px-1.5 py-0.5" style="font-size: 0.7rem;">0 - 5</span>
                      </div>
                      <div class="input-group input-group-sm">
                        <input type="number" 
                               id="w<%= w %>_ae" 
                               name="weeklyPerformance[week<%= w %>][activityEngagement]" 
                               class="form-control weekly-perf-input text-end font-monospace fw-semibold" 
                               data-week="<%= w %>"
                               data-type="ae"
                               min="0" 
                               max="5" 
                               step="0.5" 
                               placeholder="0" 
                               value="<%= ae %>" 
                               required />
                        <span class="input-group-text bg-light text-muted">/ 5</span>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>

          <!-- Continuous Evaluation Total Bar -->
          <div class="p-3 bg-light rounded-3 border d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
              <div class="bg-success bg-opacity-10 text-success p-2 rounded-2">
                <i class="bi bi-award fs-5"></i>
              </div>
              <div>
                <span class="fw-bold text-dark d-block">Continuous Evaluation Total</span>
                <small class="text-muted">Combined score across all 4 weeks (Cumulative Maximum: 40)</small>
              </div>
            </div>
            <div class="d-flex align-items-center gap-2">
              <span class="badge bg-success px-3 py-2 rounded-pill fs-6 font-monospace shadow-sm" id="continuousEvaluationBadge">
                Continuous Evaluation Total: <strong id="continuousEvaluationVal"><%= typeof weeklyPerformanceTotal === 'number' ? weeklyPerformanceTotal : 0 %></strong> / 40
              </span>
            </div>
          </div>
        </div>

        <!-- SECTION 2: FINAL ASSESSMENT -->
        <div class="mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-award-fill text-success fw-bold"></i>
              <h6 class="mb-0 fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Section 2: Final
                Assessment</h6>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="calcTotalBtn">
              <i class="bi bi-calculator"></i> Auto-sum Total
            </button>
          </div>

          <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
              <div class="d-flex align-items-center justify-content-between mb-1">
                <label for="internalMark" class="form-label fw-semibold small text-muted mb-0">Internal Mark</label>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-1.5 py-0.5" style="font-size: 0.68rem;">Auto-synced</span>
              </div>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-clipboard2-check text-muted"></i></span>
                <input type="number" id="internalMark" name="internalMark"
                  class="form-control assessment-component mark-input fw-bold text-end" min="0" max="40" placeholder="0"
                  value="<%= student.internalMark !== undefined && student.internalMark !== 0 ? student.internalMark : (typeof weeklyPerformanceTotal === 'number' ? weeklyPerformanceTotal : 0) %>" />
                <span class="input-group-text bg-light text-muted small">/ 40</span>
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <label for="theoryMark" class="form-label fw-semibold small text-muted">Theory Mark</label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-book text-muted"></i></span>
                <input type="number" id="theoryMark" name="theoryMark"
                  class="form-control assessment-component mark-input" min="0" placeholder="0"
                  value="<%= student.theoryMark !== undefined ? student.theoryMark : 0 %>" />
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <label for="practicalMark" class="form-label fw-semibold small text-muted">Practical Mark</label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-laptop text-muted"></i></span>
                <input type="number" id="practicalMark" name="practicalMark"
                  class="form-control assessment-component mark-input" min="0" placeholder="0"
                  value="<%= student.practicalMark !== undefined ? student.practicalMark : 0 %>" />
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <label for="totalMark" class="form-label fw-semibold small text-muted">Total Mark</label>
              <div class="input-group">
                <span class="input-group-text bg-white fw-bold text-primary"><i
                    class="bi bi-star-fill text-warning"></i></span>
                <input type="number" id="totalMark" name="totalMark"
                  class="form-control fw-bold bg-white text-primary border-primary-subtle mark-input" min="0"
                  placeholder="0" value="<%= student.totalMark !== undefined ? student.totalMark : 0 %>" />
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 3: OVERALL PROGRESS -->
        <div class="mb-2">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-graph-up-arrow text-info fw-bold"></i>
            <h6 class="mb-0 fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Section 3: Overall
              Progress</h6>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <label for="academicPerformance" class="form-label fw-semibold small text-muted">Academic
                Performance</label>
              <input type="text" id="academicPerformance" name="academicPerformance" class="form-control"
                placeholder="e.g. Excellent / Consistent / Grade A" value="<%= student.academicPerformance || '' %>" />
            </div>
            <div class="col-12 col-md-4">
              <label for="assignmentCompletion" class="form-label fw-semibold small text-muted">Assignment
                Completion</label>
              <input type="text" id="assignmentCompletion" name="assignmentCompletion" class="form-control"
                placeholder="e.g. 100% Completed / On Schedule" value="<%= student.assignmentCompletion || '' %>" />
            </div>
            <div class="col-12 col-md-4">
              <label for="practicalSkills" class="form-label fw-semibold small text-muted">Practical Skills</label>
              <input type="text" id="practicalSkills" name="practicalSkills" class="form-control"
                placeholder="e.g. Advanced problem solving" value="<%= student.practicalSkills || '' %>" />
            </div>
            <div class="col-12">
              <label for="overallProgress" class="form-label fw-semibold small text-muted">Overall Progress</label>
              <textarea id="overallProgress" name="overallProgress" class="form-control" rows="2"
                placeholder="Comprehensive evaluation summary of overall growth, strengths, and recommendations..."><%= student.overallProgress || '' %></textarea>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Submit -->
    <div class="d-flex align-items-center gap-3">
      <button type="submit" class="btn btn-primary btn-lg px-4" id="submitBtn">
        <i class="bi bi-check-circle-fill"></i> Update Student
      </button>
      <a href="/admin/certificates" class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>

  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const form = document.getElementById('editStudentForm');
    const submitBtn = document.getElementById('submitBtn');

    // ── Final Assessment Components & Total Mark Inputs ──
    const internalInput = document.getElementById('internalMark');
    const theoryInput = document.getElementById('theoryMark');
    const practicalInput = document.getElementById('practicalMark');
    const totalInput = document.getElementById('totalMark');
    const calcBtn = document.getElementById('calcTotalBtn');


    function calculateAssessmentTotal() {
      if (!internalInput || !theoryInput || !practicalInput || !totalInput) return;

      const internal = parseFloat(internalInput.value) || 0;
      const theory = parseFloat(theoryInput.value) || 0;
      const practical = parseFloat(practicalInput.value) || 0;

      const total = Math.round((Math.max(0, internal + theory + practical)) * 10) / 10;
      totalInput.value = total;


    }

    // ── Weekly Performance Evaluation Auto-Calculator ──
    const weeklyInputs = document.querySelectorAll('.weekly-perf-input');

    function calculateWeeklyPerformanceTotals(syncInternal = true) {
      let cumulativeTotal = 0;
      for (let w = 1; w <= 4; w++) {
        const ahEl = document.getElementById(`w${w}_ah`);
        const aeEl = document.getElementById(`w${w}_ae`);
        const totalValEl = document.getElementById(`week${w}TotalVal`);

        let ah = parseFloat(ahEl ? ahEl.value : 0) || 0;
        let ae = parseFloat(aeEl ? aeEl.value : 0) || 0;

        // Visual validation hints
        if (ah < 0) ah = 0;
        if (ah > 5) ah = 5;
        if (ae < 0) ae = 0;
        if (ae > 5) ae = 5;

        const weekTotal = Math.round((ah + ae) * 10) / 10;
        if (totalValEl) {
          totalValEl.textContent = weekTotal;
        }
        cumulativeTotal += weekTotal;
      }

      cumulativeTotal = Math.round(cumulativeTotal * 10) / 10;
      const contValEl = document.getElementById('continuousEvaluationVal');
      if (contValEl) {
        contValEl.textContent = cumulativeTotal;
      }

      // Automatically sync weekly total directly into Internal Mark input without page refresh
      if (syncInternal && internalInput) {
        internalInput.value = cumulativeTotal;
        calculateAssessmentTotal();
      }
    }

    weeklyInputs.forEach(input => {
      input.addEventListener('input', function () {
        calculateWeeklyPerformanceTotals(true);
      });
    });

    if (calcBtn) {
      calcBtn.addEventListener('click', function (e) {
        e.preventDefault();
        calculateWeeklyPerformanceTotals(true);
        calculateAssessmentTotal();
      });
    }

    [internalInput, theoryInput, practicalInput].forEach(el => {
      if (el) {
        el.addEventListener('input', calculateAssessmentTotal);
      }
    });

    // ── Form Validation & Submission ──
    if (form && submitBtn) {
      form.addEventListener('submit', function (e) {
        // Validate weekly performance inputs: 0 to 5
        for (const input of weeklyInputs) {
          if (input.value !== '') {
            const val = parseFloat(input.value);
            if (isNaN(val) || val < 0 || val > 5) {
              e.preventDefault();
              alert('Weekly Performance marks must be between 0 and 5.');
              input.focus();
              return false;
            }
          }
        }

        // Validate non-negative marks for final assessment
        const markInputs = form.querySelectorAll('.mark-input');
        for (const input of markInputs) {
          if (input.value !== '' && parseFloat(input.value) < 0) {
            e.preventDefault();
            alert('Marks cannot be negative. Please enter a valid number.');
            input.focus();
            return false;
          }
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Saving...';
      });
    }

    // Run initial calculation; if internalInput is 0 or empty, sync from weekly total
    const currentInternal = parseFloat(internalInput ? internalInput.value : 0) || 0;
    calculateWeeklyPerformanceTotals(currentInternal === 0);
    calculateAssessmentTotal();
  });
</script>