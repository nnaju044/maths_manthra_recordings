<!-- views/admin/certificates/edit.ejs -->
<div class="content-header">
  <div>
    <h2><i class="bi bi-pencil-square text-primary"></i> Edit Student</h2>
    <p class="text-muted mb-0">
      Editing: <strong><%= student.fullName || student.name %></strong>
      <% if (student.studentId) { %>
        <span class="badge bg-light text-primary border font-monospace ms-2"><%= student.studentId %></span>
      <% } %>
    </p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/certificates" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left"></i> Back to Students
    </a>
  </div>
</div>

<div class="form-card">
  <form action="/admin/certificates/<%= student._id %>/update" method="POST" class="admin-form" id="editStudentForm">

    <!-- Row 1: Name + Email -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="fullName" class="form-label fw-semibold">
          Student Name <span class="text-danger">*</span>
        </label>
        <input type="text" id="fullName" name="fullName" class="form-control form-control-lg"
               value="<%= student.fullName || student.name %>" required />
      </div>
      <div class="col-12 col-md-6">
        <label for="email" class="form-label fw-semibold">
          Email <span class="text-danger">*</span>
        </label>
        <input type="email" id="email" name="email" class="form-control form-control-lg"
               value="<%= student.email %>" required />
      </div>
    </div>

    <!-- Row 2: Phone + Qualification -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="phone" class="form-label fw-semibold">Phone Number</label>
        <input type="text" id="phone" name="phone" class="form-control"
               value="<%= student.phone || '' %>" />
      </div>
      <div class="col-12 col-md-6">
        <label for="qualification" class="form-label fw-semibold">Qualification</label>
        <input type="text" id="qualification" name="qualification" class="form-control"
               value="<%= student.qualification || '' %>" />
      </div>
    </div>

    <!-- Row 3: Course + Student ID -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="courseId" class="form-label fw-semibold">
          Course <span class="text-danger">*</span>
        </label>
        <select name="courseId" id="courseId" class="form-select form-select-lg" required>
          <option value="">-- Select Course --</option>
          <% courses.forEach(course => { %>
            <option value="<%= course._id %>" <%= student.courseId && student.courseId._id.toString() === course._id.toString() ? 'selected' : '' %>>
              <%= course.title %> <%= !course.isActive ? '(Inactive)' : '' %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-12 col-md-6">
        <label for="studentId" class="form-label fw-semibold">Student ID</label>
        <input type="text" id="studentId" name="studentId" class="form-control"
               value="<%= student.studentId || '' %>" />
      </div>
    </div>

    <!-- Row 4: Certificate Number + Issued Date (read-only reference) -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="certificateNumber" class="form-label fw-semibold">Certificate Number</label>
        <input type="text" id="certificateNumber" name="certificateNumber" class="form-control font-monospace"
               value="<%= student.certificateNumber || '' %>" />
        <div class="form-text">Auto-generated. Edit only if you need to change it.</div>
      </div>
      <div class="col-12 col-md-6">
        <label class="form-label fw-semibold">Issued Date</label>
        <input type="text" class="form-control" disabled
               value="<%= student.issuedDate ? new Date(student.issuedDate).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Not set' %>" />
      </div>
    </div>

    <!-- Row 5: Marks + Verification Status -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="marks" class="form-label fw-semibold">Marks</label>
        <input type="number" id="marks" name="marks" class="form-control mark-input"
               min="0" value="<%= student.marks || 0 %>" />
      </div>
      <div class="col-12 col-md-6">
        <label for="verificationStatus" class="form-label fw-semibold">Verification Status</label>
        <select name="verificationStatus" id="verificationStatus" class="form-select">
          <option value="true" <%= student.verificationStatus !== false ? 'selected' : '' %>>Verified</option>
          <option value="false" <%= student.verificationStatus === false ? 'selected' : '' %>>Not Verified</option>
        </select>
      </div>
    </div>

    <!-- Row 6: Profile Image URL -->
    <div class="mb-3">
      <label for="profileImage" class="form-label fw-semibold">Profile Image URL</label>
      <div class="d-flex align-items-start gap-3">
        <div class="flex-grow-1">
          <input type="url" id="profileImage" name="profileImage" class="form-control"
                 value="<%= student.profileImage || '' %>" />
        </div>
        <% if (student.profileImage && (student.profileImage.startsWith('http://') || student.profileImage.startsWith('https://'))) { %>
          <img src="<%= student.profileImage %>" alt="Profile" class="rounded-circle"
               style="width: 48px; height: 48px; object-fit: cover; border: 2px solid #e5e7eb;"
               onerror="this.style.display='none'" />
        <% } %>
      </div>
    </div>

    <!-- Row 7: Progress Card (textarea) -->
    <div class="mb-4">
      <label for="progressCard" class="form-label fw-semibold">Progress Card</label>
      <textarea id="progressCard" name="progressCard" class="form-control" rows="5"
                placeholder="Detailed student progress report, performance summary, or remarks..."><%= student.progressCard || '' %></textarea>
      <div class="form-text">
        Supports long paragraphs — e.g. course completion summary, achievements, areas of strength.
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════
         PROGRESS REPORT SECTION
         ═══════════════════════════════════════════════════════════ -->
    <div class="card border border-primary-subtle shadow-sm mb-4 bg-light-subtle rounded-3 overflow-hidden">
      <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="d-flex align-items-center gap-2">
          <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-2">
            <i class="bi bi-file-earmark-bar-graph-fill fs-5"></i>
          </div>
          <div>
            <h5 class="mb-0 fw-bold text-dark">PROGRESS REPORT</h5>
            <small class="text-muted">Comprehensive weekly and final academic assessment metrics</small>
          </div>
        </div>
        <span class="badge bg-primary px-3 py-2 rounded-pill">Evaluation Details</span>
      </div>

      <div class="card-body p-3 p-md-4">
        
        <!-- SECTION 1: WEEKLY PERFORMANCE -->
        <div class="mb-4">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-calendar4-week text-primary fw-bold"></i>
            <h6 class="mb-0 fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Section 1: Weekly Performance</h6>
          </div>
          <div class="table-responsive bg-white rounded-3 border shadow-none">
            <table class="table table-bordered table-hover align-middle mb-0">
              <thead class="table-light">
                <tr class="text-secondary small fw-semibold text-uppercase">
                  <th style="min-width: 110px;" class="ps-3">Week</th>
                  <th style="min-width: 200px;">Class Performance</th>
                  <th style="min-width: 220px;">Assignment / Homework</th>
                  <th style="min-width: 200px;">Activity / Engagement</th>
                  <th style="min-width: 140px;" class="text-end pe-3">Weekly Mark</th>
                </tr>
              </thead>
              <tbody>
                <% [1, 2, 3, 4].forEach(function(w) { 
                     const weekData = student['week' + w] || {};
                %>
                  <tr>
                    <td class="ps-3 fw-bold text-dark">
                      <span class="badge bg-light text-primary border border-primary-subtle px-2 py-1 fs-6">
                        Week <%= w %>
                      </span>
                    </td>
                    <td>
                      <input type="text" name="week<%= w %>[classPerformance]" 
                             class="form-control form-control-sm"
                             placeholder="e.g. Attentive, Consistent"
                             value="<%= weekData.classPerformance || '' %>" />
                    </td>
                    <td>
                      <input type="text" name="week<%= w %>[assignmentHomework]" 
                             class="form-control form-control-sm"
                             placeholder="e.g. Completed on time"
                             value="<%= weekData.assignmentHomework || '' %>" />
                    </td>
                    <td>
                      <input type="text" name="week<%= w %>[activityEngagement]" 
                             class="form-control form-control-sm"
                             placeholder="e.g. Active participation"
                             value="<%= weekData.activityEngagement || '' %>" />
                    </td>
                    <td class="pe-3">
                      <div class="input-group input-group-sm">
                        <input type="number" name="week<%= w %>[weeklyMark]" 
                               class="form-control form-control-sm text-end mark-input"
                               min="0" placeholder="0"
                               value="<%= typeof weekData.weeklyMark === 'number' ? weekData.weeklyMark : 0 %>" />
                        <span class="input-group-text text-muted">pts</span>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- SECTION 2: FINAL ASSESSMENT -->
        <div class="mb-4">
          <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-award-fill text-success fw-bold"></i>
              <h6 class="mb-0 fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Section 2: Final Assessment</h6>
            </div>
            <button type="button" class="btn btn-sm btn-outline-primary" id="calcTotalBtn">
              <i class="bi bi-calculator"></i> Auto-sum Total
            </button>
          </div>

          <div class="row g-3">
            <div class="col-12 col-sm-6 col-lg-3">
              <label for="internalMark" class="form-label fw-semibold small text-muted">Internal Mark</label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-clipboard2-check text-muted"></i></span>
                <input type="number" id="internalMark" name="internalMark" class="form-control assessment-component mark-input"
                       min="0" placeholder="0"
                       value="<%= student.internalMark !== undefined ? student.internalMark : 0 %>" />
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <label for="theoryMark" class="form-label fw-semibold small text-muted">Theory Mark</label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-book text-muted"></i></span>
                <input type="number" id="theoryMark" name="theoryMark" class="form-control assessment-component mark-input"
                       min="0" placeholder="0"
                       value="<%= student.theoryMark !== undefined ? student.theoryMark : 0 %>" />
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <label for="practicalMark" class="form-label fw-semibold small text-muted">Practical Mark</label>
              <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-laptop text-muted"></i></span>
                <input type="number" id="practicalMark" name="practicalMark" class="form-control assessment-component mark-input"
                       min="0" placeholder="0"
                       value="<%= student.practicalMark !== undefined ? student.practicalMark : 0 %>" />
              </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
              <label for="totalMark" class="form-label fw-semibold small text-muted">Total Mark</label>
              <div class="input-group">
                <span class="input-group-text bg-white fw-bold text-primary"><i class="bi bi-star-fill text-warning"></i></span>
                <input type="number" id="totalMark" name="totalMark" class="form-control fw-bold bg-white text-primary border-primary-subtle mark-input"
                       min="0" placeholder="0"
                       value="<%= student.totalMark !== undefined ? student.totalMark : 0 %>" />
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 3: OVERALL PROGRESS -->
        <div class="mb-2">
          <div class="d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-graph-up-arrow text-info fw-bold"></i>
            <h6 class="mb-0 fw-bold text-uppercase text-secondary" style="letter-spacing: 0.5px;">Section 3: Overall Progress</h6>
          </div>
          <div class="row g-3">
            <div class="col-12 col-md-4">
              <label for="academicPerformance" class="form-label fw-semibold small text-muted">Academic Performance</label>
              <input type="text" id="academicPerformance" name="academicPerformance" class="form-control"
                     placeholder="e.g. Excellent / Consistent / Grade A"
                     value="<%= student.academicPerformance || '' %>" />
            </div>
            <div class="col-12 col-md-4">
              <label for="assignmentCompletion" class="form-label fw-semibold small text-muted">Assignment Completion</label>
              <input type="text" id="assignmentCompletion" name="assignmentCompletion" class="form-control"
                     placeholder="e.g. 100% Completed / On Schedule"
                     value="<%= student.assignmentCompletion || '' %>" />
            </div>
            <div class="col-12 col-md-4">
              <label for="practicalSkills" class="form-label fw-semibold small text-muted">Practical Skills</label>
              <input type="text" id="practicalSkills" name="practicalSkills" class="form-control"
                     placeholder="e.g. Advanced problem solving"
                     value="<%= student.practicalSkills || '' %>" />
            </div>
            <div class="col-12">
              <label for="overallProgress" class="form-label fw-semibold small text-muted">Overall Progress</label>
              <textarea id="overallProgress" name="overallProgress" class="form-control" rows="2"
                        placeholder="Comprehensive evaluation summary of overall growth, strengths, and recommendations..."><%= student.overallProgress || '' %></textarea>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Submit -->
    <div class="d-flex align-items-center gap-3">
      <button type="submit" class="btn btn-primary btn-lg px-4" id="submitBtn">
        <i class="bi bi-check-circle-fill"></i> Update Student
      </button>
      <a href="/admin/certificates" class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>

  </form>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('editStudentForm');
    const submitBtn = document.getElementById('submitBtn');
    
    // Assessment components & total mark auto-calculator
    const internalInput = document.getElementById('internalMark');
    const theoryInput = document.getElementById('theoryMark');
    const practicalInput = document.getElementById('practicalMark');
    const totalInput = document.getElementById('totalMark');
    const calcBtn = document.getElementById('calcTotalBtn');
    const mainMarksInput = document.getElementById('marks');

    function calculateAssessmentTotal() {
      if (!internalInput || !theoryInput || !practicalInput || !totalInput) return;
      
      const internal = parseFloat(internalInput.value) || 0;
      const theory = parseFloat(theoryInput.value) || 0;
      const practical = parseFloat(practicalInput.value) || 0;
      
      const total = Math.max(0, internal + theory + practical);
      totalInput.value = total;
      
      // Also update the main marks field if it exists, as this is often expected
      if (mainMarksInput) {
        mainMarksInput.value = total;
      }
    }

    if (calcBtn) {
      calcBtn.addEventListener('click', function(e) {
        e.preventDefault();
        calculateAssessmentTotal();
      });
    }

    [internalInput, theoryInput, practicalInput].forEach(el => {
      if (el) {
        el.addEventListener('input', calculateAssessmentTotal);
      }
    });

    if (form && submitBtn) {
      form.addEventListener('submit', function (e) {
        // Validate non-negative marks
        const markInputs = form.querySelectorAll('.mark-input');
        for (const input of markInputs) {
          if (input.value !== '' && parseFloat(input.value) < 0) {
            e.preventDefault();
            alert('Marks cannot be negative. Please enter a valid number.');
            input.focus();
            return false;
          }
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span> Saving...';
      });
    }
  });
</script>
