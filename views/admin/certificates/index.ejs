<!-- Admin Certificate Students List -->
<div class="content-header">
  <div class="d-flex align-items-center gap-3 flex-wrap">
    <h2><i class="bi bi-award"></i> Certificate Students</h2>
    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
      <%= totalDocs %> <%= totalDocs === 1 ? 'Student' : 'Students' %>
    </span>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/certificates/create" class="btn btn-primary-custom">
      <i class="bi bi-person-plus"></i> Add Student
    </a>
    <a href="/admin/certificates/upload" class="btn btn-outline-primary">
      <i class="bi bi-cloud-arrow-up"></i> Upload Excel
    </a>
  </div>
</div>

<!-- Search Bar (search by email, name, certificate number, student ID) -->
<form class="search-bar mb-4" method="GET" action="/admin/certificates">
  <div class="input-group">
    <span class="input-group-text"><i class="bi bi-search"></i></span>
    <input type="text" name="search" class="form-control"
      placeholder="Search by name, email, certificate number, or student ID..." value="<%= search %>" />
    <button type="submit" class="btn btn-outline-primary">Search</button>
    <% if (search) { %>
      <a href="/admin/certificates" class="btn btn-outline-secondary">Clear</a>
    <% } %>
  </div>
</form>

<% if (docs.length === 0) { %>
  <div class="empty-state">
    <i class="bi bi-award"></i>
    <h4>No students found</h4>
    <p><%= search ? 'No students match your search criteria.' : 'Add your first student or upload an Excel sheet to get started.' %></p>
    <div class="d-flex gap-2 justify-content-center">
      <a href="/admin/certificates/create" class="btn btn-primary-custom">Add Student</a>
      <a href="/admin/certificates/upload" class="btn btn-outline-primary">Upload Excel</a>
    </div>
  </div>
<% } else { %>
  <!-- Desktop Table (visible >= 768px) -->
  <div class="table-responsive students-desktop-table">
    <table class="table admin-table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Student ID</th>
          <th>Course</th>
          <th>Marks</th>
          <th>Certificate No.</th>
          <th>Verification</th>
          <th>Status</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% docs.forEach(student => { %>
          <tr>
            <!-- Name -->
            <td>
              <div class="course-cell">
                <% if (student.profileImage && (student.profileImage.startsWith('http://') || student.profileImage.startsWith('https://'))) { %>
                  <img src="<%= student.profileImage %>" alt="" class="course-thumb-sm rounded-circle" onerror="this.style.display='none'" />
                <% } else { %>
                  <div class="course-thumb-placeholder rounded-circle" style="background: rgba(37, 99, 235, 0.1); color: #2563eb; font-weight: 700; width: 42px; height: 42px; min-width: 42px; display: flex; align-items: center; justify-content: center;">
                    <%= (student.fullName || student.name || 'S').charAt(0).toUpperCase() %>
                  </div>
                <% } %>
                <div>
                  <div class="fw-semibold">
                    <%= student.fullName || student.name %>
                  </div>
                  <% if (student.qualification) { %>
                    <div class="text-muted small">
                      <%= student.qualification %>
                    </div>
                  <% } %>
                </div>
              </div>
            </td>

            <!-- Email -->
            <td>
              <span class="text-dark"><%= student.email %></span>
            </td>

            <!-- Student ID -->
            <td>
              <% if (student.studentId) { %>
                <code class="slug-display"><%= student.studentId %></code>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </td>

            <!-- Course -->
            <td>
              <span class="fw-medium text-secondary">
                <%= student.courseId ? student.courseId.title : '—' %>
              </span>
            </td>

            <!-- Marks -->
            <td>
              <span class="badge bg-light text-dark border px-2 py-1"><%= student.marks || 0 %></span>
            </td>

            <!-- Certificate Number -->
            <td>
              <code class="slug-display"><%= student.certificateNumber || '—' %></code>
            </td>

            <!-- Verification Status -->
            <td>
              <% if (student.verificationStatus !== false) { %>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                  <i class="bi bi-check-circle-fill"></i> Verified
                </span>
              <% } else { %>
                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                  <i class="bi bi-exclamation-circle-fill"></i> Unverified
                </span>
              <% } %>
            </td>

            <!-- Status -->
            <td>
              <button class="badge-status-btn <%= student.isActive ? 'active' : 'inactive' %>"
                onclick="toggleStudentActive('<%= student._id %>', this)" title="Click to toggle status" type="button">
                <%= student.isActive ? 'Active' : 'Inactive' %>
              </button>
            </td>

            <!-- Actions -->
            <td class="text-end">
              <div class="action-btns justify-content-end">
                <a href="/admin/certificates/<%= student._id %>/edit" class="btn-action edit" title="Edit Student" aria-label="Edit Student">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="/admin/certificates/<%= student._id %>/delete" method="POST" class="d-inline"
                  onsubmit="return confirm('Delete this student certificate record? This cannot be undone.')">
                  <button type="submit" class="btn-action delete" title="Delete Student" aria-label="Delete Student">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Mobile Student Cards (visible < 768px) -->
  <div class="students-mobile-cards">
    <% docs.forEach(student => { %>
      <div class="student-mobile-card">
        <div class="student-card-body">
          <div class="student-card-header d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center gap-2">
              <% if (student.profileImage && (student.profileImage.startsWith('http://') || student.profileImage.startsWith('https://'))) { %>
                <img src="<%= student.profileImage %>" alt="" class="rounded-circle" style="width: 38px; height: 38px; object-fit: cover;" onerror="this.style.display='none'" />
              <% } else { %>
                <div class="rounded-circle" style="background: rgba(37, 99, 235, 0.1); color: #2563eb; font-weight: 700; width: 38px; height: 38px; display: flex; align-items: center; justify-content: center;">
                  <%= (student.fullName || student.name || 'S').charAt(0).toUpperCase() %>
                </div>
              <% } %>
              <div>
                <h3 class="student-card-title mb-0"><%= student.fullName || student.name %></h3>
                <small class="text-muted"><%= student.qualification || 'Student' %></small>
              </div>
            </div>
            <button class="badge-status-btn <%= student.isActive ? 'active' : 'inactive' %>"
              onclick="toggleStudentActive('<%= student._id %>', this)" title="Click to toggle status" type="button">
              <%= student.isActive ? 'Active' : 'Inactive' %>
            </button>
          </div>

          <div class="student-card-info-list mb-3">
            <div class="info-item d-flex justify-content-between py-1 border-bottom">
              <span class="text-muted small">Email</span>
              <span class="small fw-medium"><%= student.email %></span>
            </div>
            <div class="info-item d-flex justify-content-between py-1 border-bottom">
              <span class="text-muted small">Phone</span>
              <span class="small"><%= student.phone || '—' %></span>
            </div>
            <div class="info-item d-flex justify-content-between py-1 border-bottom">
              <span class="text-muted small">Student ID</span>
              <code class="slug-display small"><%= student.studentId || '—' %></code>
            </div>
            <div class="info-item d-flex justify-content-between py-1 border-bottom">
              <span class="text-muted small">Course</span>
              <span class="small fw-medium text-end text-truncate" style="max-width: 60%;"><%= student.courseId ? student.courseId.title : '—' %></span>
            </div>
            <div class="info-item d-flex justify-content-between py-1 border-bottom">
              <span class="text-muted small">Marks</span>
              <span class="small fw-medium"><%= student.marks || 0 %></span>
            </div>
            <div class="info-item d-flex justify-content-between py-1 border-bottom">
              <span class="text-muted small">Certificate No.</span>
              <code class="slug-display small"><%= student.certificateNumber || '—' %></code>
            </div>
            <div class="info-item d-flex justify-content-between py-1 border-bottom">
              <span class="text-muted small">Verification</span>
              <% if (student.verificationStatus !== false) { %>
                <span class="badge bg-success-subtle text-success small px-2 py-1">Verified</span>
              <% } else { %>
                <span class="badge bg-warning-subtle text-warning small px-2 py-1">Unverified</span>
              <% } %>
            </div>
            <% if (student.progressCard) { %>
              <div class="info-item py-1 border-bottom">
                <span class="text-muted small d-block mb-1">Progress Card</span>
                <span class="small text-secondary" style="white-space: pre-line;"><%= student.progressCard.length > 120 ? student.progressCard.substring(0, 120) + '...' : student.progressCard %></span>
              </div>
            <% } %>
            <div class="info-item d-flex justify-content-between py-1">
              <span class="text-muted small">Created Date</span>
              <span class="small text-muted"><%= formatDate(student.createdAt) %></span>
            </div>
          </div>

          <div class="student-card-actions d-flex gap-2">
            <a href="/admin/certificates/<%= student._id %>/edit" class="btn-card-action btn-card-edit flex-grow-1" title="Edit Student" aria-label="Edit Student">
              <i class="bi bi-pencil"></i>
              <span>Edit</span>
            </a>
            <form action="/admin/certificates/<%= student._id %>/delete" method="POST" class="flex-grow-1"
              onsubmit="return confirm('Delete this student certificate record? This cannot be undone.')">
              <button type="submit" class="btn-card-action btn-card-delete w-100" title="Delete Student" aria-label="Delete Student">
                <i class="bi bi-trash"></i>
                <span>Delete</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Pagination (matching Courses design pattern) -->
  <% if (totalPages > 1) { %>
    <nav class="pagination-nav">
      <% if (hasPrev) { %>
        <a href="/admin/certificates?page=<%= prevPage %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="page-link-custom">← Previous</a>
      <% } %>
      <span class="page-info">Page <%= currentPage %> of <%= totalPages %></span>
      <% if (hasNext) { %>
        <a href="/admin/certificates?page=<%= nextPage %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="page-link-custom">Next →</a>
      <% } %>
    </nav>
  <% } %>
<% } %>
