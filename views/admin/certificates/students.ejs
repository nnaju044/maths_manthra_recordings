<!-- views/admin/certificates/students.ejs -->
<div class="content-header">
  <div>
    <h2><i class="bi bi-people text-primary"></i> Certificate Students</h2>
    <p class="text-muted mb-0">List of students with generated course certificates.</p>
  </div>
  <div class="d-flex gap-2">
    <a href="/admin/certificates/upload" class="btn btn-primary">
      <i class="bi bi-file-earmark-arrow-up"></i> Upload Students
    </a>
  </div>
</div>

<!-- Filters Bar -->
<div class="card border-0 shadow-sm mb-4 p-3" style="border-radius: 12px; background: #ffffff;">
  <form action="/admin/certificates/students" method="GET" class="row g-2 align-items-center">
    <!-- Course Filter -->
    <div class="col-12 col-md-5">
      <div class="input-group">
        <label class="input-group-text bg-light text-muted"><i class="bi bi-book"></i></label>
        <select name="courseId" class="form-select" onchange="this.form.submit()">
          <option value="">All Courses</option>
          <% courses.forEach(c => { %>
            <option value="<%= c._id %>" <%= selectedCourseId === c._id.toString() ? 'selected' : '' %>>
              <%= c.title %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>

    <!-- Search Input -->
    <div class="col-12 col-md-5">
      <div class="input-group">
        <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
        <input type="text" name="search" class="form-control"
               placeholder="Search by name, email, or certificate number..."
               value="<%= search %>" />
      </div>
    </div>

    <!-- Actions -->
    <div class="col-12 col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-secondary w-100">
        Filter
      </button>
      <% if (selectedCourseId || search) { %>
        <a href="/admin/certificates/students" class="btn btn-outline-secondary" title="Clear filters">
          <i class="bi bi-x-lg"></i>
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Students List -->
<% if (docs && docs.length > 0) { %>
  <div class="table-responsive bg-white rounded-3 shadow-sm border mb-4">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Student</th>
          <th>Certificate No.</th>
          <th>Course</th>
          <th>Contact</th>
          <th>Qualification</th>
          <th>Issued Date</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% docs.forEach((student, idx) => { %>
          <tr>
            <td>
              <div class="d-flex align-items-center gap-2">
                <% if (student.profileImage && (student.profileImage.startsWith('http://') || student.profileImage.startsWith('https://'))) { %>
                  <img src="<%= student.profileImage %>" alt="" class="rounded-circle" style="width: 36px; height: 36px; object-fit: cover;" onerror="this.style.display='none'" />
                <% } else { %>
                  <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.9rem;">
                    <%= (student.fullName || student.name || 'S').charAt(0).toUpperCase() %>
                  </div>
                <% } %>
                <div>
                  <div class="fw-semibold text-dark"><%= student.fullName || student.name %></div>
                  <small class="text-muted"><%= student.email %></small>
                </div>
              </div>
            </td>
            <td>
              <span class="badge bg-light text-primary border font-monospace px-2 py-1">
                <%= student.certificateNumber || 'N/A' %>
              </span>
            </td>
            <td>
              <span class="fw-medium text-secondary">
                <%= student.courseId ? student.courseId.title : 'Deleted Course' %>
              </span>
            </td>
            <td>
              <div class="small">
                <% if (student.phone) { %>
                  <div><i class="bi bi-telephone text-muted"></i> <%= student.phone %></div>
                <% } %>
                <div><i class="bi bi-envelope text-muted"></i> <%= student.email %></div>
              </div>
            </td>
            <td>
              <span class="small text-secondary">
                <%= student.qualification || '—' %>
              </span>
            </td>
            <td>
              <small class="text-muted">
                <%= student.issuedDate ? new Date(student.issuedDate).toLocaleDateString() : new Date(student.createdAt).toLocaleDateString() %>
              </small>
            </td>
            <td class="text-end">
              <form action="/admin/certificates/students/<%= student._id %>/delete" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete certificate for <%= (student.fullName || student.name).replace(/'/g, &quot;\\'&quot;) %>?');"
                    class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete record">
                  <i class="bi bi-trash"></i>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  <% if (totalPages > 1) { %>
    <nav class="d-flex justify-content-center mt-4">
      <ul class="pagination pagination-sm">
        <% if (hasPrevPage) { %>
          <li class="page-item">
            <a class="page-link" href="?page=<%= prevPage %>&courseId=<%= selectedCourseId %>&search=<%= search %>">Previous</a>
          </li>
        <% } %>

        <% for (let p = 1; p <= totalPages; p++) { %>
          <li class="page-item <%= p === page ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= p %>&courseId=<%= selectedCourseId %>&search=<%= search %>"><%= p %></a>
          </li>
        <% } %>

        <% if (hasNextPage) { %>
          <li class="page-item">
            <a class="page-link" href="?page=<%= nextPage %>&courseId=<%= selectedCourseId %>&search=<%= search %>">Next</a>
          </li>
        <% } %>
      </ul>
    </nav>
  <% } %>

<% } else { %>
  <!-- Empty State -->
  <div class="card border-0 shadow-sm p-5 text-center bg-white" style="border-radius: 12px;">
    <div class="mb-3">
      <i class="bi bi-award text-muted" style="font-size: 3.5rem;"></i>
    </div>
    <h4 class="fw-bold">No Certificate Students Found</h4>
    <p class="text-muted mb-4">
      <% if (selectedCourseId || search) { %>
        No students matched your search criteria. Try resetting the filters.
      <% } else { %>
        You have not uploaded any certificate students yet. Upload an Excel sheet to generate certificates.
      <% } %>
    </p>
    <div>
      <% if (selectedCourseId || search) { %>
        <a href="/admin/certificates/students" class="btn btn-outline-secondary me-2">Clear Filters</a>
      <% } %>
      <a href="/admin/certificates/upload" class="btn btn-primary">
        <i class="bi bi-file-earmark-arrow-up"></i> Upload Students
      </a>
    </div>
  </div>
<% } %>
