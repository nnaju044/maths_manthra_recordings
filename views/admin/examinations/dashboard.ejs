<div class="container-fluid py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
      <h3 class="fw-bold mb-1"><i class="bi bi-speedometer2 me-2 text-primary"></i>Examinations Dashboard</h3>
      <p class="text-muted small mb-0">Overview of institutional exams, student participation, grading status, and certificates.</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/examinations/create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i> Create Examination
      </a>
      <a href="/admin/questions" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-question-diamond me-1"></i> Question Bank
      </a>
    </div>
  </div>

  <!-- Metric KPI Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="bg-primary-subtle text-primary rounded-3 p-3 me-3 fs-3">
            <i class="bi bi-journal-check"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Total Exams</div>
            <div class="fs-4 fw-bold"><%= stats.totalExams %></div>
            <div class="text-success extra-small"><i class="bi bi-broadcast me-1"></i><%= stats.publishedExams %> Published</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="bg-success-subtle text-success rounded-3 p-3 me-3 fs-3">
            <i class="bi bi-question-diamond"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Question Bank</div>
            <div class="fs-4 fw-bold"><%= stats.totalQuestions %></div>
            <div class="text-muted extra-small">Active questions across all categories</div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="bg-info-subtle text-info rounded-3 p-3 me-3 fs-3">
            <i class="bi bi-person-workspace"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Student Attempts</div>
            <div class="fs-4 fw-bold"><%= stats.totalAttempts %></div>
            <div class="text-muted extra-small"><span class="text-success"><%= stats.passedCount %> passed</span> · <span class="text-danger"><%= stats.failedCount %> failed</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body d-flex align-items-center">
          <div class="bg-warning-subtle text-warning rounded-3 p-3 me-3 fs-3">
            <i class="bi bi-award"></i>
          </div>
          <div>
            <div class="text-muted small fw-semibold">Certificates Issued</div>
            <div class="fs-4 fw-bold"><%= stats.totalCertificatesIssued %></div>
            <div class="text-muted extra-small"><%= stats.pendingEvaluationCount %> evaluations pending</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Content Rows -->
  <div class="row g-4">
    <!-- Recent Examinations -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0"><i class="bi bi-journal-text me-2 text-primary"></i>Recent Examinations</h6>
          <a href="/admin/examinations" class="small text-decoration-none">View All</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Mode</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentExams && recentExams.length > 0) { %>
                <% recentExams.forEach(exam => { %>
                  <tr>
                    <td>
                      <a href="/admin/examinations/<%= exam._id %>/edit" class="text-decoration-none fw-semibold">
                        <%= exam.title %>
                      </a>
                    </td>
                    <td><span class="badge bg-light text-dark border"><%= exam.category %></span></td>
                    <td><span class="badge bg-secondary-subtle text-secondary border text-capitalize"><%= exam.availabilityMode %></span></td>
                    <td>
                      <span class="badge <%= exam.status === 'published' ? 'bg-success' : exam.status === 'draft' ? 'bg-secondary' : 'bg-danger' %>">
                        <%= exam.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="4" class="text-center py-4 text-muted small">No examinations created yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Recent Student Attempts -->
    <div class="col-lg-6">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h6 class="fw-bold mb-0"><i class="bi bi-people me-2 text-info"></i>Recent Attempts</h6>
          <span class="badge bg-light text-muted border">Live Stream</span>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Student</th>
                <th>Examination</th>
                <th>Attempt</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentAttempts && recentAttempts.length > 0) { %>
                <% recentAttempts.forEach(att => { %>
                  <tr>
                    <td>
                      <div class="fw-semibold small"><%= att.studentId?.fullName || 'Student' %></div>
                      <div class="text-muted extra-small"><%= att.studentId?.email || 'N/A' %></div>
                    </td>
                    <td class="small text-truncate" style="max-width: 180px;"><%= att.examinationId?.title || 'Unknown Exam' %></td>
                    <td><span class="badge bg-light text-dark border">#<%= att.attemptNumber %></span></td>
                    <td>
                      <span class="badge <%= att.status === 'submitted' ? 'bg-success-subtle text-success' : att.status === 'in_progress' ? 'bg-warning-subtle text-warning' : 'bg-secondary' %>">
                        <%= att.status %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr><td colspan="4" class="text-center py-4 text-muted small">No student attempts recorded yet.</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

