# ============================
# Maths Mantras — Environment
# ============================

# App
NODE_ENV=development
PORT=3000
APP_NAME=Maths Mantras
# APP_URL — Leave blank to auto-detect from the request host (recommended).
# Set ONLY when you need to force a specific base URL, e.g. a custom domain:
# APP_URL=https://mathsmanthrarecordings-production.up.railway.app

# MongoDB
MONGO_URI=mongodb://localhost:27017/maths_mantras

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Session
SESSION_SECRET=your_session_secret_change_this_in_production
SESSION_EXPIRES_IN=86400000

# Bcrypt
BCRYPT_ROUNDS=12

# Email (SMTP) — leave blank to use console logging in dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Maths Mantras <noreply@mathsmantras.com>


# Cookie
COOKIE_MAX_AGE=604800000

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
